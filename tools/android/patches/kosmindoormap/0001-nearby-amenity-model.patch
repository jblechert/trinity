+struct {
+    const char *groupName;
+    AbstractAmenityModel::Group group;
+} constexpr const group_map[] = {
+    { "accommodation", AbstractAmenityModel::AccommodationGroup },
+    { "amenity", AbstractAmenityModel::AmenityGroup },
+    { "healthcare", AbstractAmenityModel::HealthcareGroup },
+    { "food", AbstractAmenityModel::FoodGroup },
+    { "shop", AbstractAmenityModel::ShopGroup },
+    { "toilets", AbstractAmenityModel::ToiletGroup },
+};
