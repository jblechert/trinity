+
+double NearbyAmenityModel::maximumRadius(double lat, double lon)
+{
+    // tiles are square in Web Mercator projection, so the width also tells us the height in meter
+    // the search area spans 4 tile widths then, which can touch at most 5 tiles
+    const auto bbox = Tile::fromCoordinate(lat, lon, MapLoaderUtil::TileZoomLevel).boundingBox();
+    const auto tileWidth = OSM::distance(lat, bbox.min.lonF(), lat, bbox.max.lonF());
+    return tileWidth * (MaximumTileSpan - 1) / 2.0 * 0.95; // leave some room for the projection distortion within the area
+}
+
+static bool parseElementId(const QString &s, OSM::Type &type, OSM::Id &id)
+{
+    static const QRegularExpression rx(u"^([nwr])(\\d+)$"_s, QRegularExpression::CaseInsensitiveOption);
+    const auto match = rx.match(s.trimmed());
+    if (!match.hasMatch()) {
+        return false;
+    }
+
+    switch (match.capturedView(1).at(0).toLower().toLatin1()) {
+        case 'n':
+            type = OSM::Type::Node;
+            break;
+        case 'w':
+            type = OSM::Type::Way;
+            break;
+        case 'r':
+            type = OSM::Type::Relation;
+            break;
+    }
+    bool ok = false;
+    id = match.capturedView(2).toLongLong(&ok);
+    return ok && id > 0;
+}
+
+void NearbyAmenityModel::scheduleReload()
+{
+    m_reloadTimer.start();
+}
+
+void NearbyAmenityModel::reload()
+{
+    m_reloadTimer.stop();
+    setErrorMessage({});
+
+    Request req;
+    req.lat = m_lat;
+    req.lon = m_lon;
+    if (std::isnan(req.lat) || std::isnan(req.lon) || std::abs(req.lat) > 85.0 || std::abs(req.lon) > 180.0 || !(m_radius > 0.0)) {
+        // nothing to search for
+        clear();
+        return;
+    }
+    req.radius = std::min(m_radius, maximumRadius(req.lat, req.lon));
+
+    if (!m_elementId.isEmpty() && !parseElementId(m_elementId, req.elementType, req.elementId)) {
+        qCWarning(Log) << "invalid OSM element id:" << m_elementId;
+        clear();
+        Q_EMIT finished();
+        return;
+    }
+
+    const auto bbox = OSM::boundingBoxForRadius(OSM::Coordinate(req.lat, req.lon), req.radius);
+    const auto tiles = MapLoaderUtil::tilesForBoundingBox(bbox);
+    m_request = req;
+
+    // we already have all the data we need
+    if (!m_loading && !m_data.isEmpty() && m_loadedTiles.contains(tiles)) {
+        populateModel(req);
+        Q_EMIT finished();
+        return;
+    }
+
+    m_pendingTiles = tiles;
+    setLoading(true);
+    m_loader.loadForBoundingBox(bbox);
+}
+
+void NearbyAmenityModel::loadingDone()
+{
+    // ignore results of loads we are no longer interested in, e.g. after the search parameters got unset
+    if (!m_loading) {
+        return;
+    }
+
+    if (m_loader.hasError()) {
+        qCDebug(Log) << m_loader.errorMessage();
+        setErrorMessage(m_loader.errorMessage());
+        clear();
+        Q_EMIT finished();
+        return;
+    }
+
+    auto data = std::move(m_loader.takeData());
+    if (!data.timeZone().isValid()) {
+        data.setTimeZone(QTimeZone(KTimeZone::fromLocation((float)m_request.lat, (float)m_request.lon)));
+    }
+
+    // the old data needs to stay alive until the reset of the model content
+    const auto prevData = m_data;
+    m_data = std::move(data);
+    m_loadedTiles = m_pendingTiles;
+    if (loadStyle()) {
+        compileStyle();
+    }
+    populateModel(m_request);
+    setLoading(false);
+    Q_EMIT finished();
+}
+
+void NearbyAmenityModel::populateModel(const Request &req)
+{
+    const auto prevCount = rowCount();
+    beginResetModel();
+    m_entries.clear();
+    m_contentCenter = OSM::Coordinate(req.lat, req.lon);
+    if (!m_data.isEmpty() && loadStyle()) {
+        if (req.elementType != OSM::Type::Null) {
+            populateFromElementId(req);
+        } else {
+            populateFromArea(req);
+        }
+    }
+    endResetModel();
+    if (prevCount != rowCount()) {
+        Q_EMIT countChanged();
+    }
+}
+
+void NearbyAmenityModel::populateFromElementId(const Request &req)
+{
+    const auto &dataSet = m_data.dataSet();
+    OSM::Element element;
+    switch (req.elementType) {
+        case OSM::Type::Null:
+            return;
+        case OSM::Type::Node:
+            if (const auto node = dataSet.node(req.elementId)) {
+                element = OSM::Element(node);
+            }
+            break;
+        case OSM::Type::Way:
+            if (const auto way = dataSet.way(req.elementId)) {
+                element = OSM::Element(way);
+            }
+            break;
+        case OSM::Type::Relation:
+            if (const auto rel = dataSet.relation(req.elementId)) {
+                element = OSM::Element(rel);
+            }
+            break;
+    }
+    if (!element) {
+        qCDebug(Log) << "element not found:" << m_elementId;
+        return;
+    }
+    if (!element.boundingBox().isValid()) {
+        element.recomputeBoundingBox(dataSet);
+    }
+
+    Entry entry;
+    if (classify(element, entry) == Classification::Excluded) {
+        // something we wouldn't list on our own, but that has been explicitly asked for
+        // try to provide a type nevertheless
+        entry = {};
+        entry.element = element;
+        for (const char *key : {"amenity", "shop", "tourism", "leisure", "office", "historic", "healthcare"}) {
+            const auto value = element.tagValue(key);
+            if (!value.isEmpty() && Localization::hasAmenityTypeTranslation(value.constData())) {
+                entry.typeKey = key;
+                entry.icon = QString::fromUtf8(value);
+                break;
+            }
+        }
+    }
+    entry.level = levelForElement(element);
+    m_entries.push_back(std::move(entry));
+}
+
+void NearbyAmenityModel::populateFromArea(const Request &req)
+{
+    const OSM::Coordinate center(req.lat, req.lon);
+    const auto nameKey = m_data.dataSet().tagKey("name");
+
+    for (auto it = m_data.levelMap().begin(); it != m_data.levelMap().end(); ++it) {
+        for (const auto &e : (*it).second) {
+            const auto dist = OSM::distance(center, e.center());
+            if (dist > req.radius && (e.type() == OSM::Type::Node || !OSM::contains(e.boundingBox(), center))) {
+                continue;
+            }
+
+            Entry entry;
+            switch (classify(e, entry)) {
+                case Classification::Excluded:
+                    continue;
+                case Classification::UnknownType:
+                    // things we have no translated type name for are only useful when there is a name to display
+                    if (!e.hasTag(nameKey)) {
+                        continue;
+                    }
+                    break;
+                case Classification::Amenity:
+                    break;
+            }
+
+            entry.level = (*it).first.numericLevel();
+            m_entries.push_back(std::move(entry));
+        }
+    }
+
+    // de-duplicate multi-level entries, see AmenityModel
+    std::sort(m_entries.begin(), m_entries.end(), [](const auto &lhs, const auto &rhs) {
+        if (lhs.element == rhs.element) {
+            return std::abs(lhs.level) < std::abs(rhs.level);
+        }
+        return lhs.element < rhs.element;
+    });
+    m_entries.erase(std::unique(m_entries.begin(), m_entries.end(), [](const auto &lhs, const auto &rhs) {
+        return lhs.element == rhs.element;
+    }), m_entries.end());
+
+    // sort by distance, prefer smaller elements on equal distance (e.g. a shop over the building it is in)
+    struct SortKey {
+        double distance;
+        double area;
+    };
+    std::vector<std::pair<SortKey, Entry>> sorted;
+    sorted.reserve(m_entries.size());
+    for (auto &entry : m_entries) {
+        const auto bbox = entry.element.boundingBox();
+        sorted.push_back({{OSM::distance(center, entry.element.center()), bbox.widthF() * bbox.heightF()}, std::move(entry)});
+    }
+    std::stable_sort(sorted.begin(), sorted.end(), [](const auto &lhs, const auto &rhs) {
+        if (lhs.first.distance == rhs.first.distance) {
+            if (lhs.first.area == rhs.first.area) {
+                return lhs.second.element.type() < rhs.second.element.type();
+            }
+            return lhs.first.area < rhs.first.area;
+        }
+        return lhs.first.distance < rhs.first.distance;
+    });
+    m_entries.clear();
+    std::transform(std::make_move_iterator(sorted.begin()), std::make_move_iterator(sorted.end()), std::back_inserter(m_entries), [](auto &&e) {
+        return std::move(e.second);
+    });
+
+    qCDebug(Log) << m_entries.size() << "amenities found";
+}
+
+int NearbyAmenityModel::levelForElement(OSM::Element element) const
+{
+    std::optional<int> level;
+    for (const auto &[mapLevel, elements] : m_data.levelMap()) {
+        if (std::find(elements.begin(), elements.end(), element) != elements.end()) {
+            if (!level || std::abs(mapLevel.numericLevel()) < std::abs(*level)) {
+                level = mapLevel.numericLevel();
+            }
+        }
+    }
+    return level.value_or(0);
+}
+
+void NearbyAmenityModel::setLoading(bool loading)
+{
+    if (m_loading == loading) {
+        return;
+    }
+    m_loading = loading;
+    Q_EMIT loadingChanged();
+}
+
+void NearbyAmenityModel::setErrorMessage(const QString &msg)
+{
+    if (m_errorMessage == msg) {
+        return;
+    }
+    m_errorMessage = msg;
+    Q_EMIT errorMessageChanged();
+}
+
+void NearbyAmenityModel::clear()
+{
+    setLoading(false);
+    if (m_data.isEmpty() && m_entries.empty()) {
+        return;
+    }
+
+    const auto prevCount = rowCount();
+    beginResetModel();
+    m_entries.clear();
+    endResetModel();
+    // release the data only after there are no more references to it from the model content
+    m_data = MapData();
+    m_loadedTiles = {};
+    if (prevCount != 0) {
+        Q_EMIT countChanged();
+    }
+}
+
+QVariantMap NearbyAmenityModel::get(int row) const
+{
+    QVariantMap res;
+    if (row < 0 || row >= rowCount()) {
+        return res;
+    }
+
+    const auto idx = index(row, 0);
+    const auto roles = roleNames();
+    for (auto it = roles.begin(); it != roles.end(); ++it) {
+        res.insert(QString::fromUtf8(it.value()), data(idx, it.key()));
+    }
+    return res;
+}
+
+QVariant NearbyAmenityModel::data(const QModelIndex &index, int role) const
+{
+    if (!checkIndex(index)) {
+        return {};
+    }
+
+    if (role == DistanceRole) {
+        return OSM::distance(m_contentCenter, m_entries[index.row()].element.center());
+    }
+    return AbstractAmenityModel::data(index, role);
+}
+
+QHash<int, QByteArray> NearbyAmenityModel::roleNames() const
+{
+    auto r = AbstractAmenityModel::roleNames();
+    r.insert(DistanceRole, "distance");
+    return r;
+}
+
+#include "moc_nearbyamenitymodel.cpp"
