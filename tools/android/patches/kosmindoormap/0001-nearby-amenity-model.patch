+BoundingBox OSM::boundingBoxForRadius(Coordinate center, double radius)
+{
+    // one degree of latitude has (almost) the same length everywhere, one degree of longitude shrinks towards the poles
+    const auto lat = center.latF();
+    const auto lon = center.lonF();
+    const auto dlat = radius / distance(0.0, lon, 1.0, lon);
+    const auto dlon = radius / distance(lat, 0.0, lat, 1.0);
+    return BoundingBox(Coordinate(lat - dlat, lon - dlon), Coordinate(lat + dlat, lon + dlon));
+}
