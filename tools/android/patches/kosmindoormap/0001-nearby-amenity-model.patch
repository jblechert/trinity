+++ b/autotests/nearbyamenitymodeltest.cpp
@@ -0,0 +1,437 @@
+/*
+    SPDX-FileCopyrightText: 2026 Janis Blechert <janis@blechert.at>
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#include "../src/map-quick/nearbyamenitymodel.h"
+#include "../src/map-quick/osmelement.h"
+#include "../src/map-quick/osmelementinformationmodel.h"
+
+#include <map/loader/maploader_p.h>
+#include <map/loader/tilecache_p.h>
+
+#include <osm/abstractwriter.h>
+#include <osm/datatypes.h>
+#include <osm/geomath.h>
+#include <osm/io.h>
+
+#include <QAbstractItemModelTester>
+#include <QDir>
+#include <QFile>
+#include <QPointF>
+#include <QScopeGuard>
+#include <QSignalSpy>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+#include <QTest>
+
+using namespace Qt::Literals::StringLiterals;
+using namespace KOSMIndoorMap;
+
+void initLocale()
+{
+    qputenv("LC_ALL", "en_US.utf-8");
+    qputenv("TZ", "UTC");
+
+    Q_INIT_RESOURCE(assets);
+}
+
+Q_CONSTRUCTOR_FUNCTION(initLocale)
+
+// center of the z17 tile containing the test data, see the comment in the test data file
+constexpr inline double CenterLat = 52.5203991;
+constexpr inline double CenterLon = 13.3992004;
+
+class NearbyAmenityModelTest : public QObject
+{
+    Q_OBJECT
+private:
+    QTemporaryDir m_tmpDir;
+
+    [[nodiscard]] static QStringList names(const NearbyAmenityModel &model)
+    {
+        QStringList l;
+        for (int i = 0; i < model.rowCount(); ++i) {
+            const auto idx = model.index(i, 0);
+            auto n = idx.data(NearbyAmenityModel::NameRole).toString();
+            l.push_back(n.isEmpty() ? idx.data(NearbyAmenityModel::TypeNameRole).toString() : n);
+        }
+        return l;
+    }
+
+    /** Writes @p dataSet as raw data tile @p tile into the tile directory structure below @p dir. */
+    [[nodiscard]] static bool writeTile(const QString &dir, const Tile &tile, const OSM::DataSet &dataSet)
+    {
+        const auto tileDir = dir + "/17/"_L1 + QString::number(tile.x);
+        QFile tileFile(tileDir + '/'_L1 + QString::number(tile.y) + ".o5m"_L1);
+        if (!QDir().mkpath(tileDir) || !tileFile.open(QFile::WriteOnly)) {
+            return false;
+        }
+        auto writer = OSM::IO::writerForFileName(tileFile.fileName());
+        if (!writer) {
+            return false;
+        }
+        writer->write(dataSet, &tileFile);
+        return tileFile.size() > 0;
+    }
+
+    /** Use the tiles in @p dir as tile server, until the returned guard goes out of scope. */
+    [[nodiscard]] static auto useTileServer(const QString &dir)
+    {
+        qputenv("KOSMINDOORMAP_TILESERVER", QUrl::fromLocalFile(dir + '/'_L1).toEncoded());
+        return qScopeGuard([]() {
+            qputenv("KOSMINDOORMAP_TILESERVER", QByteArray("file:///nonexistent/kosmindoormap-tileserver/"));
+        });
+    }
+
+    static void search(NearbyAmenityModel &model, double lat, double lon, double radius, const QString &elementId = {})
+    {
+        QSignalSpy finishedSpy(&model, &NearbyAmenityModel::finished);
+        model.setLatitude(lat);
+        model.setLongitude(lon);
+        model.setRadius(radius);
+        model.setElementId(elementId);
+        QVERIFY(finishedSpy.wait());
+        QCOMPARE(finishedSpy.size(), 1);
+        QVERIFY(!model.isLoading());
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        // make sure we neither touch the user's tile cache nor the network
+        QStandardPaths::setTestModeEnabled(true);
+        QVERIFY(m_tmpDir.isValid());
+        qputenv("KOSMINDOORMAP_CACHE_PATH", QFile::encodeName(m_tmpDir.path() + "/cache/"_L1));
+        qputenv("KOSMINDOORMAP_TILESERVER", QByteArray("file:///nonexistent/kosmindoormap-tileserver/"));
+
+        // convert the test data into a cached raw data tile
+        const QString osmFile = QStringLiteral(SOURCE_DIR "/data/nearbyamenitymodel/nearbyamenitymodeltest.osm");
+        QFile inFile(osmFile);
+        QVERIFY(inFile.open(QFile::ReadOnly));
+        OSM::DataSet dataSet;
+        auto reader = OSM::IO::readerForFileName(osmFile, &dataSet);
+        QVERIFY(reader);
+        reader->read(&inFile);
+        QVERIFY(!dataSet.nodes.empty());
+
+        const auto tile = Tile::fromCoordinate(CenterLat, CenterLon, 17);
+        QCOMPARE(tile.x, 70414u);
+        QCOMPARE(tile.y, 42985u);
+        QVERIFY(writeTile(m_tmpDir.path() + "/cache"_L1, tile, dataSet));
+
+        // the same data as a not yet cached tile further away, for testing downloads
+        QVERIFY(writeTile(m_tmpDir.path() + "/server"_L1, Tile(tile.x + 10, tile.y, 17), dataSet));
+    }
+
+    void testRadiusAndOrder_data()
+    {
+        QTest::addColumn<double>("radius");
+        QTest::addColumn<QStringList>("expected");
+
+        QTest::newRow("20m") << 20.0 << QStringList({u"Toilets"_s, u"Bakery One"_s, u"Central Park"_s});
+        QTest::newRow("28m") << 28.0 << QStringList({u"Toilets"_s, u"Bakery One"_s, u"Cafe Two"_s, u"Central Park"_s});
+        QTest::newRow("50m") << 50.0 << QStringList({u"Toilets"_s, u"Bakery One"_s, u"Cafe Two"_s, u"Central Park"_s, u"St. Example"_s, u"Fashion Hall"_s});
+        QTest::newRow("85m") << 85.0 << QStringList({u"Toilets"_s, u"Bakery One"_s, u"Cafe Two"_s, u"Central Park"_s, u"St. Example"_s, u"Fashion Hall"_s, u"Woodworks"_s, u"Old Memorial"_s, u"Market Eight"_s});
+    }
+
+    void testRadiusAndOrder()
+    {
+        QFETCH(double, radius);
+        QFETCH(QStringList, expected);
+
+        NearbyAmenityModel model;
+        QAbstractItemModelTester modelTest(&model);
+        QCOMPARE(model.radius(), 30.0);
+        QCOMPARE(model.count(), 0);
+
+        QSignalSpy countSpy(&model, &NearbyAmenityModel::countChanged);
+        search(model, CenterLat, CenterLon, radius);
+        QVERIFY(model.errorMessage().isEmpty());
+        QCOMPARE(names(model), expected);
+        QCOMPARE(model.count(), expected.size());
+        QCOMPARE(countSpy.size(), 1);
+
+        double prevDistance = 0.0;
+        for (int i = 0; i < model.rowCount(); ++i) {
+            const auto dist = model.index(i, 0).data(NearbyAmenityModel::DistanceRole).toDouble();
+            QVERIFY(dist >= prevDistance);
+            prevDistance = dist;
+        }
+    }
+
+    void testRoles()
+    {
+        NearbyAmenityModel model;
+        QAbstractItemModelTester modelTest(&model);
+        search(model, CenterLat, CenterLon, 85.0);
+        QCOMPARE(model.rowCount(), 9);
+
+        const auto roles = model.roleNames();
+        for (const auto &role : {"name", "typeName", "iconSource", "element", "coordinate", "openingHours", "timeZone", "regionCode",
+                                 "fallbackName", "detailsLabel", "cuisine", "group", "groupName", "level", "distance"}) {
+            QVERIFY2(roles.values().contains(QByteArray(role)), role);
+        }
+
+        // unnamed toilets
+        auto idx = model.index(0, 0);
+        QVERIFY(idx.data(NearbyAmenityModel::NameRole).toString().isEmpty());
+        QCOMPARE(idx.data(NearbyAmenityModel::TypeNameRole).toString(), "Toilets"_L1);
+        QCOMPARE(idx.data(NearbyAmenityModel::GroupRole).toInt(), NearbyAmenityModel::ToiletGroup);
