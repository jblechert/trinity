@@ -0,0 +1,50 @@
+/*
+    SPDX-FileCopyrightText: 2026 Janis Blechert <janis@blechert.at>
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#include <osm/datatypes.h>
+#include <osm/geomath.h>
+
+#include <QTest>
+
+class GeoMathTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void testBoundingBoxForRadius_data()
+    {
+        QTest::addColumn<double>("lat");
+        QTest::addColumn<double>("lon");
+        QTest::addColumn<double>("radius");
+
+        QTest::newRow("equator") << 0.0 << 0.0 << 1000.0;
+        QTest::newRow("berlin") << 52.52 << 13.40 << 1000.0;
+        QTest::newRow("berlin-small") << 52.52 << 13.40 << 30.0;
+        QTest::newRow("southern") << -33.86 << 151.21 << 500.0;
+        QTest::newRow("north") << 69.65 << 18.96 << 2000.0;
+    }
+
+    void testBoundingBoxForRadius()
+    {
+        QFETCH(double, lat);
+        QFETCH(double, lon);
+        QFETCH(double, radius);
+
+        const OSM::Coordinate center(lat, lon);
+        const auto bbox = OSM::boundingBoxForRadius(center, radius);
+        QVERIFY(bbox.isValid());
+        QVERIFY(OSM::contains(bbox, center));
+
+        // the box touches the circle in all four directions
+        const auto tolerance = std::max(radius * 0.005, 0.5);
+        QVERIFY(std::abs(OSM::distance(lat, lon, bbox.max.latF(), lon) - radius) < tolerance);
+        QVERIFY(std::abs(OSM::distance(lat, lon, bbox.min.latF(), lon) - radius) < tolerance);
+        QVERIFY(std::abs(OSM::distance(lat, lon, lat, bbox.max.lonF()) - radius) < tolerance);
+        QVERIFY(std::abs(OSM::distance(lat, lon, lat, bbox.min.lonF()) - radius) < tolerance);
+    }
+};
+
+QTEST_GUILESS_MAIN(GeoMathTest)
+
+#include "geomathtest.moc"
diff --git a/autotests/maploadertest.cpp b/autotests/maploadertest.cpp
new file mode 100644
index 00000000..f9897321
--- /dev/null
+++ b/autotests/maploadertest.cpp
@@ -0,0 +1,140 @@
+/*
+    SPDX-FileCopyrightText: 2026 Janis Blechert <janis@blechert.at>
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#include <map/loader/maploader_p.h>
+#include <map/loader/tilecache_p.h>
+
+#include <KOSMIndoorMap/MapData>
+#include <KOSMIndoorMap/MapLoader>
+
+#include <osm/abstractwriter.h>
+#include <osm/datatypes.h>
+#include <osm/io.h>
+
+#include <QBuffer>
+#include <QDir>
+#include <QFile>
+#include <QSignalSpy>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+#include <QTest>
+
+using namespace Qt::Literals::StringLiterals;
+using namespace KOSMIndoorMap;
+
+class MapLoaderTest : public QObject
+{
+    Q_OBJECT
+private:
+    QTemporaryDir m_tmpDir;
+
+    // two neighboring z17 tiles, the first one is cached, the second one can only be downloaded
+    const Tile m_cachedTile = Tile(70414, 42985, 17);
+    const Tile m_remoteTile = Tile(70415, 42985, 17);
+
+    /** Writes a tile containing a single node with id @p id at the center of @p tile into @p dir. */
+    [[nodiscard]] static bool writeTile(const QString &dir, const Tile &tile, OSM::Id id)
+    {
+        const auto c = tile.boundingBox().center();
+        const auto xml = u"<osm><node id=\"%1\" lat=\"%2\" lon=\"%3\"><tag k=\"amenity\" v=\"cafe\"/></node></osm>"_s
+            .arg(id).arg(c.latF(), 0, 'f', 7).arg(c.lonF(), 0, 'f', 7).toUtf8();
+        QBuffer buffer;
+        buffer.setData(xml);
+        if (!buffer.open(QIODevice::ReadOnly)) {
+            return false;
+        }
+        OSM::DataSet dataSet;
+        auto reader = OSM::IO::readerForFileName(u"tile.osm", &dataSet);
+        reader->read(&buffer);
+        if (dataSet.nodes.size() != 1) {
+            return false;
+        }
+
+        const auto tileDir = dir + "/17/"_L1 + QString::number(tile.x);
+        QFile f(tileDir + '/'_L1 + QString::number(tile.y) + ".o5m"_L1);
+        if (!QDir().mkpath(tileDir) || !f.open(QFile::WriteOnly)) {
+            return false;
+        }
+        auto writer = OSM::IO::writerForFileName(f.fileName());
+        writer->write(dataSet, &f);
+        return true;
+    }
+
+    /** Box well within @p tile. */
+    [[nodiscard]] static OSM::BoundingBox innerBox(const Tile &tile)
+    {
+        const auto c = tile.boundingBox().center();
+        return OSM::BoundingBox(OSM::Coordinate(c.latF() - 0.0001, c.lonF() - 0.0001), OSM::Coordinate(c.latF() + 0.0001, c.lonF() + 0.0001));
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        // make sure we neither touch the user's tile cache nor the network
+        QStandardPaths::setTestModeEnabled(true);
+        QVERIFY(m_tmpDir.isValid());
+        qputenv("KOSMINDOORMAP_CACHE_PATH", QFile::encodeName(m_tmpDir.path() + "/cache/"_L1));
+        qputenv("KOSMINDOORMAP_TILESERVER", QUrl::fromLocalFile(m_tmpDir.path() + "/server/"_L1).toEncoded());
+
+        QVERIFY(writeTile(m_tmpDir.path() + "/cache"_L1, m_cachedTile, 1));
+        QVERIFY(writeTile(m_tmpDir.path() + "/server"_L1, m_remoteTile, 2));
+    }
+
+    void testTilesForBoundingBox()
+    {
+        QCOMPARE(MapLoaderUtil::tilesForBoundingBox(innerBox(m_cachedTile)), QRect(70414, 42985, 1, 1));
+
+        // spanning the two test tiles
+        const auto box = OSM::unite(innerBox(m_cachedTile), innerBox(m_remoteTile));
+        QCOMPARE(MapLoaderUtil::tilesForBoundingBox(box), QRect(70414, 42985, 2, 1));
+
+        // north-south direction, slippy map tile y coordinates grow southwards
+        const auto northernBox = innerBox(Tile(70414, 42984, 17));
+        QCOMPARE(MapLoaderUtil::tilesForBoundingBox(OSM::unite(innerBox(m_cachedTile), northernBox)), QRect(70414, 42984, 1, 2));
+    }
+
+    // a new load started while the previous one still has queued work pending
+    // must not finish multiple times, nor use the data of the previous load
+    void testRestartWithCachedTiles()
+    {
+        MapLoader loader;
+        MapData data;
+        QSignalSpy doneSpy(&loader, &MapLoader::done);
+        connect(&loader, &MapLoader::done, this, [&loader, &data]() {
+            data = loader.takeData();
+        });
+
+        loader.loadForBoundingBox(innerBox(m_cachedTile));
+        loader.loadForBoundingBox(innerBox(m_cachedTile));
+        QVERIFY(doneSpy.wait());
+        QCoreApplication::processEvents();
+        QCOMPARE(doneSpy.size(), 1);
+        QVERIFY(!loader.hasError());
+        QVERIFY(data.dataSet().node(1));
+    }
+
+    void testRestartWithUncachedTiles()
+    {
+        MapLoader loader;
+        MapData data;
+        QSignalSpy doneSpy(&loader, &MapLoader::done);
+        connect(&loader, &MapLoader::done, this, [&loader, &data]() {
+            data = loader.takeData();
+        });
+
+        loader.loadForBoundingBox(innerBox(m_cachedTile));
+        loader.loadForBoundingBox(innerBox(m_remoteTile));
+        QVERIFY(doneSpy.wait());
+        QCoreApplication::processEvents();
+        QCOMPARE(doneSpy.size(), 1);
+        QVERIFY(!loader.hasError());
+        QVERIFY(!data.dataSet().node(1));
+        QVERIFY(data.dataSet().node(2));
+    }
+};
+
+QTEST_GUILESS_MAIN(MapLoaderTest)
+
+#include "maploadertest.moc"
