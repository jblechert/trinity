+void NearbyAmenityModel::setLatitude(double lat)
+{
+    if (m_lat == lat || (std::isnan(m_lat) && std::isnan(lat))) {
+        return;
+    }
+    m_lat = lat;
+    Q_EMIT latitudeChanged();
+    scheduleReload();
+}
