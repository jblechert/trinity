+        QVERIFY(idx.data(NearbyAmenityModel::IconSourceRole).toString().endsWith("/bakery.svg"_L1));
+        QCOMPARE(idx.data(NearbyAmenityModel::OpeningHoursRole).toString(), "Mo-Sa 06:00-18:00"_L1);
