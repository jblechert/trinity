+NearbyAmenityModel::NearbyAmenityModel(QObject *parent)
+    : AbstractAmenityModel(u":/org.kde.kosmindoormap/assets/quick/nearby-amenity-model.mapcss"_s, parent)
+{
+    connect(&m_loader, &MapLoader::done, this, &NearbyAmenityModel::loadingDone);
+
+    // coalesce changes to multiple search parameters
+    m_reloadTimer.setSingleShot(true);
+    m_reloadTimer.setInterval(0);
+    connect(&m_reloadTimer, &QTimer::timeout, this, &NearbyAmenityModel::reload);
+}
+
+NearbyAmenityModel::~NearbyAmenityModel() = default;
+
+double NearbyAmenityModel::latitude() const
+{
+    return m_lat;
+}
