+AbstractAmenityModel::Classification AbstractAmenityModel::classify(OSM::Element element, Entry &entry) const
+{
+    MapCSSState filterState;
+    filterState.element = element;
+    m_style.initializeState(filterState);
+    m_style.evaluate(filterState, m_filterResult);
+
+    const auto &res = m_filterResult[{}];
+    if (auto prop = res.declaration(MapCSSProperty::Opacity); !prop || prop->doubleValue() < 1.0) {
+        return Classification::Excluded; // hidden element
+    }
+
+    const auto group = res.resolvedTagValue(m_layerKey, filterState);
+    if (!group) {
+        return Classification::Excluded;
+    }
+    const auto groupIt = std::find_if(std::begin(group_map), std::end(group_map), [&group](const auto &m) { return std::strcmp(m.groupName, (*group).constData()) == 0; });
+    if (groupIt == std::end(group_map)) {
+        return Classification::Excluded; // no group assigned
+    }
+
+    QByteArray typeKey;
+    if (auto prop = res.declaration(MapCSSProperty::FontFamily); prop) {
+        typeKey = prop->keyValue();
+    }
+    if (typeKey.isEmpty()) {
+        return Classification::Excluded;
+    }
+
+    entry.element = element;
+    entry.group = (*groupIt).group;
+    entry.typeKey.clear();
+    entry.icon.clear();
+
+    if (auto prop = res.declaration(MapCSSProperty::IconImage); prop) {
+        entry.icon = prop->stringValue();
+        if (entry.icon.isEmpty()) {
+            entry.icon = QString::fromUtf8(element.tagValue(prop->keyValue().constData()));
+        }
+    }
+
+    const auto types = element.tagValue(typeKey.constData()).split(';');
+    for (const auto &type : types) {
+        if (Localization::hasAmenityTypeTranslation(type.trimmed().constData())) {
+            entry.typeKey = std::move(typeKey);
+            return Classification::Amenity;
+        }
+    }
+
+    qCDebug(Log) << "unknown type: " << types << element.url();
+    return Classification::UnknownType;
+}
