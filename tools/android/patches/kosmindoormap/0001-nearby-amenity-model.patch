+namespace KOSMIndoorMap {
+
+/** Amenities and other points of interest around a given location.
+ *
+ *  This loads the raw OSM data tiles covering the search area and lists all amenities
+ *  (classified the same way as in AmenityModel) as well as other named points of interest
+ *  (such as places of worship, historic sites or craft businesses) whose center is within
+ *  @p radius around the given coordinate, ordered by distance. Areas whose bounding box contains
+ *  the coordinate are included as well, even if their center is further away.
+ *
+ *  Alternatively, when @p elementId is set, the model contains only that specific OSM element
+ *  if it is found in the data loaded for the search area, regardless of its distance or type.
+ *  This is useful for showing details for a search result from an external service.
+ *
+ *  This is meant for small search areas, such as identifying what is at a tapped location on a map.
+ *  The search area is limited to at most 5x5 tiles at zoom level 17, ie. the effective radius
+ *  is capped to a bit less than two tile widths (about 580 m at the equator, 350 m at 52° latitude).
+ *
+ *  The model keeps the loaded map data alive for as long as it contains elements, and the
+ *  elements returned by the @c element role keep their data alive as well. That is, they can
+ *  safely be passed to OSMElementInformationModel even if this model is reloaded afterwards.
+ *
+ *  Roles are the same as for AmenityModel, plus a @c distance role.
+ *
+ *  @since 27.04
+ */
+class NearbyAmenityModel : public AbstractAmenityModel
+{
+    Q_OBJECT
+    /** Latitude of the center of the search area, in degree. */
+    Q_PROPERTY(double latitude READ latitude WRITE setLatitude NOTIFY latitudeChanged)
+    /** Longitude of the center of the search area, in degree. */
+    Q_PROPERTY(double longitude READ longitude WRITE setLongitude NOTIFY longitudeChanged)
+    /** Search radius around the center coordinate, in meter.
+     *  Defaults to 30 m, which is in the order of a finger tap on a map at high zoom levels.
+     */
+    Q_PROPERTY(double radius READ radius WRITE setRadius NOTIFY radiusChanged)
+    /** Optional OSM element to look for, in the form "n123", "w123" or "r123"
+     *  (for a node, way or relation, respectively).
+     *  The element is looked up in the data loaded for the search area, so latitude and longitude
+     *  need to be set to a coordinate in its vicinity (e.g. its center) as well.
+     */
+    Q_PROPERTY(QString elementId READ elementId WRITE setElementId NOTIFY elementIdChanged)
+
+    /** @c true while map data is being loaded. */
+    Q_PROPERTY(bool loading READ isLoading NOTIFY loadingChanged)
+    /** Number of rows in this model. */
+    Q_PROPERTY(int count READ count NOTIFY countChanged)
+    /** Error message in case loading the map data failed, empty otherwise. */
+    Q_PROPERTY(QString errorMessage READ errorMessage NOTIFY errorMessageChanged)
+
+public:
+    explicit NearbyAmenityModel(QObject *parent = nullptr);
+    ~NearbyAmenityModel();
+
+    enum NearbyRole {
+        DistanceRole = FirstCustomRole, ///< distance between the center coordinate and the element's center, in meter
+    };
+    Q_ENUM(NearbyRole)
+
+    [[nodiscard]] double latitude() const;
+    void setLatitude(double lat);
+    [[nodiscard]] double longitude() const;
+    void setLongitude(double lon);
+    [[nodiscard]] double radius() const;
+    void setRadius(double radius);
+    [[nodiscard]] QString elementId() const;
+    void setElementId(const QString &elementId);
+
+    [[nodiscard]] bool isLoading() const;
+    [[nodiscard]] int count() const;
+    [[nodiscard]] QString errorMessage() const;
+
+    /** Load the data for the current search parameters and update the model content.
+     *  This happens automatically when any of the search parameters change, so you usually
+     *  don't need to call this, unless you want to retry after an error.
+     */
+    Q_INVOKABLE void reload();
+
+    /** Returns all role values of the entry in row @p row, by role name.
+     *  Convenience for QML, e.g. for accessing the nearest element.
+     */
+    [[nodiscard]] Q_INVOKABLE QVariantMap get(int row) const;
+
+    [[nodiscard]] QVariant data(const QModelIndex &index, int role) const override;
+    [[nodiscard]] QHash<int, QByteArray> roleNames() const override;
+
+    /** Largest radius that can be used around the given coordinate, in meter.
+     *  @internal exposed for unit tests
+     */
+    [[nodiscard]] static double maximumRadius(double lat, double lon);
+
+Q_SIGNALS:
+    void latitudeChanged();
+    void longitudeChanged();
+    void radiusChanged();
+    void elementIdChanged();
+    void loadingChanged();
+    void countChanged();
+    void errorMessageChanged();
+    /** Emitted when the model content has been updated for the current search parameters,
+     *  or when loading failed.
+     *  This is not emitted when the search parameters are incomplete (e.g. no coordinate set),
+     *  the model is just cleared then.
+     */
+    void finished();
+
+private:
+    struct Request {
+        double lat = NAN;
+        double lon = NAN;
+        double radius = 0.0;
+        OSM::Type elementType = OSM::Type::Null;
+        OSM::Id elementId = 0;
+    };
+
+    void scheduleReload();
+    void loadingDone();
+    void populateModel(const Request &req);
+    void populateFromElementId(const Request &req);
+    void populateFromArea(const Request &req);
+    [[nodiscard]] int levelForElement(OSM::Element element) const;
+    void setLoading(bool loading);
+    void setErrorMessage(const QString &msg);
+    void clear();
+
+    double m_lat = NAN;
+    double m_lon = NAN;
+    double m_radius = 30.0;
+    QString m_elementId;
+
+    Request m_request; // the request the current content or the pending load is for
+    OSM::Coordinate m_contentCenter; // the search center the current content has been computed for
+    QRect m_loadedTiles; // tiles covered by m_data
+    QRect m_pendingTiles; // tiles covered by the currently loading data
+    MapLoader m_loader;
+    QTimer m_reloadTimer;
+    bool m_loading = false;
+    QString m_errorMessage;
+};
+
+}
