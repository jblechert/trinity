+#ifndef KOSMINDOORMAP_ABSTRACTAMENITYMODEL_H
+#define KOSMINDOORMAP_ABSTRACTAMENITYMODEL_H
+
+#include <KOSMIndoorMap/MapData>
+#include <KOSMIndoorMap/MapCSSResult>
+#include <KOSMIndoorMap/MapCSSStyle>
+
+#include <KOSM/Element>
+
+#include <QAbstractListModel>
+
+namespace KOSMIndoorMap {
+
+/** Common base class for models listing amenities.
+ *  This contains the classification of OSM elements based on a MapCSS style sheet
+ *  as well as the data access for the roles shared by all amenity models.
+ *  @since 27.04
+ */
+class AbstractAmenityModel : public QAbstractListModel
+{
+    Q_OBJECT
+public:
+    ~AbstractAmenityModel();
+
+    enum Role {
+        NameRole = Qt::DisplayRole,
+        CoordinateRole = Qt::UserRole,
+        LevelRole,
+        ElementRole,
+        TypeNameRole,
+        GroupRole,
+        GroupNameRole,
+        IconSourceRole,
+        CuisineRole, ///< details on entries in the FoodGroup
+        FallbackNameRole, ///< Brand/operator/network name, better than nothing but not the first choice to display
+        OpeningHoursRole, ///< opening hours expression
+        TimeZoneRole, ///< IANA timezone id this amenity is in (relevant for opening hours interpretation)
+        RegionCodeRole, ///< ISO 3166-1/2 code of the region this amenity is in (relevant for opening hours interpretation)
+        ToiletDetailsRole, ///< details information for the ToiletGroup
+        DetailsLabelRole, ///< section-dependent details label (e.g. CuisineRole or ToiletDetailsRole)
+        // new common roles go above this, sub-classes start their own roles here
+        FirstCustomRole = Qt::UserRole + 100, ///< first role id available for roles specific to a sub-class
+    };
+    Q_ENUM(Role)
+
+    enum Group {
+        UndefinedGroup,
+        FoodGroup,
+        ShopGroup,
+        ToiletGroup,
+        AmenityGroup,
+        HealthcareGroup,
+        AccommodationGroup,
+    };
+    Q_ENUM(Group)
+
+    [[nodiscard]] int rowCount(const QModelIndex &parent = {}) const override;
+    [[nodiscard]] QVariant data(const QModelIndex &index, int role) const override;
+    [[nodiscard]] QHash<int, QByteArray> roleNames() const override;
+
+protected:
+    /** @param styleSheet MapCSS style sheet used for selecting and classifying elements.
+     *  - opacity is used to include/exclude elements
+     *  - grouping is done via setting the layer tag to: food, shop, toilets, amenity, healthcare, accommodation
+     *  - icon-image is used for the icon
+     *  - font-family is the key of the tag containing the type
+     */
+    explicit AbstractAmenityModel(const QString &styleSheet, QObject *parent = nullptr);
+
+    struct Entry {
+        OSM::Element element;
+        int level = 0;
+        Group group = UndefinedGroup;
+        QByteArray typeKey;
+        QString icon;
+    };
+
+    /** Result of classify(). */
+    enum class Classification {
+        Excluded, ///< element is not an amenity according to the style sheet
+        Amenity, ///< element is an amenity of a type we can display
+        UnknownType, ///< element is selected by the style sheet, but its type is unknown to us
+    };
+
+    /** Loads the style sheet, if that hasn't happened yet.
+     *  @returns @c false if the style sheet could not be loaded.
+     */
+    bool loadStyle();
+    /** Prepares the style sheet for use with the data set of m_data.
+     *  Call this whenever m_data changes.
+     */
+    void compileStyle();
+
+    /** Classify @p element according to the style sheet.
+     *  In case of Classification::Amenity @p entry is filled with everything but the level,
+     *  in case of Classification::UnknownType everything but level and type key is set.
+     */
+    [[nodiscard]] Classification classify(OSM::Element element, Entry &entry) const;
+
+    /** Data for the roles of an amenity entry. */
+    [[nodiscard]] QVariant entryData(const Entry &entry, int role) const;
+
+    MapData m_data;
+    std::vector<Entry> m_entries;
+    OSM::Languages m_langs;
+
+private:
+    [[nodiscard]] static QString iconSource(const Entry &entry);
+
+    QString m_styleSheet;
+    MapCSSStyle m_style;
+    OSM::TagKey m_layerKey;
+    mutable MapCSSResult m_filterResult;
+};
+
+}
+
+#endif // KOSMINDOORMAP_ABSTRACTAMENITYMODEL_H
