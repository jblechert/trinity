+    void testElementLookup_data()
+    {
+        QTest::addColumn<QString>("elementId");
+        QTest::addColumn<QString>("name");
+        QTest::addColumn<QString>("typeName");
+
+        QTest::newRow("node") << u"n4"_s << u"St. Example"_s << u"Place of Worship"_s;
+        QTest::newRow("way") << u"w100"_s << u"Fashion Hall"_s << u"Clothes"_s;
+        QTest::newRow("upper case") << u"W100"_s << u"Fashion Hall"_s << u"Clothes"_s;
+        QTest::newRow("not an amenity") << u"n6"_s << QString() << u"Bench"_s;
+        QTest::newRow("private") << u"n7"_s << u"Private Lounge"_s << u"Cafe"_s;
+        QTest::newRow("stolperstein") << u"n11"_s << u"Erika Mustermann"_s << u"Memorial"_s;
+        QTest::newRow("unknown") << u"n999"_s << QString() << QString();
+        QTest::newRow("wrong type") << u"r4"_s << QString() << QString();
+        QTest::newRow("invalid") << u"x4"_s << QString() << QString();
+    }
+
+    void testElementLookup()
+    {
+        QFETCH(QString, elementId);
+        QFETCH(QString, name);
+        QFETCH(QString, typeName);
+
+        NearbyAmenityModel model;
+        QAbstractItemModelTester modelTest(&model);
+        // a search result coordinate close to the element, the element doesn't need to be within the radius
+        search(model, CenterLat + 0.0001, CenterLon, 20.0, elementId);
+        QVERIFY(model.errorMessage().isEmpty());
+
+        if (name.isEmpty() && typeName.isEmpty()) {
+            QCOMPARE(model.rowCount(), 0);
+            return;
+        }
+
+        QCOMPARE(model.rowCount(), 1);
+        const auto idx = model.index(0, 0);
+        QCOMPARE(idx.data(NearbyAmenityModel::NameRole).toString(), name);
+        QCOMPARE(idx.data(NearbyAmenityModel::TypeNameRole).toString(), typeName);
+        QCOMPARE(idx.data(NearbyAmenityModel::ElementRole).value<OSMElement>().id(), elementId.mid(1).toLongLong());
+        QCOMPARE(idx.data(NearbyAmenityModel::TimeZoneRole).toString(), "Europe/Berlin"_L1);
+        QVERIFY(idx.data(NearbyAmenityModel::DistanceRole).toDouble() > 0.0);
+    }
+
+    void testReuseLoadedData()
+    {
+        NearbyAmenityModel model;
+        QAbstractItemModelTester modelTest(&model);
+        search(model, CenterLat, CenterLon, 50.0);
+        QCOMPARE(model.rowCount(), 6);
+
+        // changes within the already loaded area don't need to load anything
+        QSignalSpy loadingSpy(&model, &NearbyAmenityModel::loadingChanged);
+        search(model, CenterLat, CenterLon, 20.0);
+        QCOMPARE(model.rowCount(), 3);
+        search(model, CenterLat, CenterLon, 20.0, u"n10"_s);
+        QCOMPARE(model.rowCount(), 1);
+        QCOMPARE(model.index(0, 0).data(NearbyAmenityModel::NameRole).toString(), "Old Memorial"_L1);
+        QCOMPARE(loadingSpy.size(), 0);
+
+        // an explicit reload works as well
+        QSignalSpy finishedSpy(&model, &NearbyAmenityModel::finished);
+        model.reload();
+        QVERIFY(finishedSpy.size() == 1 || finishedSpy.wait());
+        QCOMPARE(model.rowCount(), 1);
+    }
+
+    void testElementLifetime()
+    {
+        NearbyAmenityModel model;
+        search(model, CenterLat, CenterLon, 20.0);
+        QCOMPARE(model.rowCount(), 3);
+
+        OSMElementInformationModel infoModel;
+        infoModel.setElement(model.index(1, 0).data(NearbyAmenityModel::ElementRole).value<OSMElement>());
+        QCOMPARE(infoModel.name(), "Bakery One"_L1);
+        QVERIFY(infoModel.rowCount() > 0);
+
+        // unsetting the coordinate clears the model and releases its data,
+        // the information model keeps it alive though
+        QSignalSpy countSpy(&model, &NearbyAmenityModel::countChanged);
+        model.setLatitude(NAN);
+        QVERIFY(countSpy.wait());
+        QCOMPARE(model.rowCount(), 0);
+        QCOMPARE(infoModel.name(), "Bakery One"_L1);
+        QCOMPARE(infoModel.element().name(), "Bakery One"_L1);
+    }
+
+    void testLoadingError()
+    {
+        // somewhere we have no cached tiles for, and the tile server doesn't exist
+        NearbyAmenityModel model;
+        QAbstractItemModelTester modelTest(&model);
+        QSignalSpy loadingSpy(&model, &NearbyAmenityModel::loadingChanged);
+        search(model, 48.0, 11.0, 20.0);
+        QCOMPARE(loadingSpy.size(), 2);
+        QVERIFY(!model.errorMessage().isEmpty());
+        QCOMPARE(model.rowCount(), 0);
+    }
+
+    // changing the search parameters while a search is in progress
+    void testRestartWhileLoading()
+    {
+        NearbyAmenityModel model;
+        QAbstractItemModelTester modelTest(&model);
+        QSignalSpy finishedSpy(&model, &NearbyAmenityModel::finished);
+        model.setLatitude(CenterLat);
+        model.setLongitude(CenterLon);
+        model.setRadius(50.0);
+        model.reload();
+        QVERIFY(model.isLoading());
+        QCOMPARE(model.rowCount(), 0);
+        model.setRadius(20.0);
+        model.reload();
+        QVERIFY(finishedSpy.wait());
+        QCoreApplication::processEvents();
+        QCOMPARE(finishedSpy.size(), 1);
+        QVERIFY(!model.isLoading());
+        QCOMPARE(names(model), QStringList({u"Toilets"_s, u"Bakery One"_s, u"Central Park"_s}));
+
+        // the old content keeps the distances to the location it has been computed for while loading for a new one
+        QCOMPARE(qRound(model.index(1, 0).data(NearbyAmenityModel::DistanceRole).toDouble()), 10);
+        model.setLatitude(48.0);
+        model.reload();
+        QVERIFY(model.isLoading());
+        QCOMPARE(qRound(model.index(1, 0).data(NearbyAmenityModel::DistanceRole).toDouble()), 10);
+        QVERIFY(finishedSpy.wait());
+    }
+
+    void testRestartIntoUncachedTile()
+    {
+        const auto server = useTileServer(m_tmpDir.path() + "/server"_L1);
+        // the center of the tile with the second copy of the test data
+        const auto remoteCenter = Tile(Tile::fromCoordinate(CenterLat, CenterLon, 17).x + 10, 42985, 17).boundingBox().center();
+
+        NearbyAmenityModel model;
+        QAbstractItemModelTester modelTest(&model);
+        QSignalSpy finishedSpy(&model, &NearbyAmenityModel::finished);
+        model.setLatitude(CenterLat);
+        model.setLongitude(CenterLon);
+        model.setRadius(20.0);
+        model.reload(); // cached
+        model.setLongitude(remoteCenter.lonF());
+        model.setElementId(u"n4"_s);
+        model.reload(); // needs a download
+        QVERIFY(finishedSpy.wait());
+        QCoreApplication::processEvents();
+        QCOMPARE(finishedSpy.size(), 1);
+        QVERIFY(model.errorMessage().isEmpty());
+        QCOMPARE(model.rowCount(), 1);
+        QCOMPARE(model.index(0, 0).data(NearbyAmenityModel::NameRole).toString(), "St. Example"_L1);
+    }
+
+    void testRadiusCap()
+    {
+        // serve empty tiles for the largest possible search area around the cached tile,
+        // anything beyond that would fail to load
+        const auto center = Tile::fromCoordinate(CenterLat, CenterLon, 17);
+        OSM::DataSet emptyDataSet;
+        for (auto x = center.x - 2; x <= center.x + 2; ++x) {
+            for (auto y = center.y - 2; y <= center.y + 2; ++y) {
+                if (x != center.x || y != center.y) {
+                    QVERIFY(writeTile(m_tmpDir.path() + "/capserver"_L1, Tile(x, y, 17), emptyDataSet));
+                }
+            }
+        }
+        const auto server = useTileServer(m_tmpDir.path() + "/capserver"_L1);
+
+        // the radius used is capped to stay within those tiles
+        const auto maxRadius = NearbyAmenityModel::maximumRadius(CenterLat, CenterLon);
+        const auto tiles = MapLoaderUtil::tilesForBoundingBox(OSM::boundingBoxForRadius(OSM::Coordinate(CenterLat, CenterLon), maxRadius));
+        QVERIFY(tiles.width() <= 5);
+        QVERIFY(tiles.height() <= 5);
+        QVERIFY(QRect(center.x - 2, center.y - 2, 5, 5).contains(tiles));
+
+        NearbyAmenityModel model;
+        QAbstractItemModelTester modelTest(&model);
+        search(model, CenterLat, CenterLon, 5000.0);
+        QCOMPARE(model.radius(), 5000.0);
+        QVERIFY(model.errorMessage().isEmpty());
+        QCOMPARE(model.rowCount(), 9);
+    }
+
+    void testMaximumRadius()
+    {
+        const auto r = NearbyAmenityModel::maximumRadius(CenterLat, CenterLon);
+        QVERIFY(r > 300.0);
+        QVERIFY(r < 400.0);
+        QVERIFY(NearbyAmenityModel::maximumRadius(0.0, 0.0) > 550.0);
+    }
+};
