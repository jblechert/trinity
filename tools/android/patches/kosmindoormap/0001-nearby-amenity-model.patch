@@ -0,0 +1,74 @@
+/*
+    SPDX-FileCopyrightText: 2026 Janis Blechert <janis@blechert.at>
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+/* Nearby amenity model content selection and classification
+ * This uses the same rules as the amenity model, see there for details.
+ * On top of that, this adds named elements that aren't useful in a list of
+ * amenities of a station or airport, but that a user might look for or tap
+ * on in an outdoor map.
+ */
+
+/* Rules before the import have lower precedence than the amenity model rules,
+ * ie. they only apply when there is no more specific classification already.
+ */
+*[historic=building][name],
+*[historic=church][name],
+*[historic=city_gate][name],
+*[historic=fort][name],
+*[historic=manor][name],
+*[historic=memorial][name],
+*[historic=monastery][name],
+*[historic=palace][name],
+*[historic=ruins][name],
+*[historic=tomb][name],
+*[historic=tower][name],
+*[historic=wayside_cross][name],
+*[historic=wayside_shrine][name]
+{
+    opacity: 1;
+    icon-image: historic;
+    font-family: historic;
+    set layer = "amenity";
+}
+
+*[craft][craft!=yes][name]
+{
+    opacity: 1;
+    icon-image: craft;
+    font-family: craft;
+    set layer = "shop";
+}
+
+/* Small memorials such as Stolpersteine or plaques are very dense in some cities, usually right at
+ * house entrances, so they would often hide the shop or cafe a user tapped on.
+ */
+*[historic=memorial][memorial=stolperstein],
+*[historic=memorial][memorial=plaque],
+*[historic=memorial][memorial=blue_plaque]
+{
+    opacity: 0;
+}
+
+@import url("amenity-model.mapcss");
+
+/* Rules after the import override the amenity model rules. */
+*[amenity=college][name],
+*[amenity=fountain][name],
+*[amenity=kindergarten][name],
+*[amenity=parking][name],
+*[amenity=place_of_worship][name],
+*[amenity=school][name],
+*[leisure=garden][name],
+*[tourism=artwork][name]
+{
+    opacity: 1;
+}
+
+/* repeated from the amenity model, as this has to take precedence over the above */
+*[access=no],
+*[access=private]
+{
+    opacity: 0;
+}
