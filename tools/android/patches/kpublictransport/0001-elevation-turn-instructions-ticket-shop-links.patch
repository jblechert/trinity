+namespace {
+struct UicCountry {
+    uint8_t uicCode;
+    const char isoCode[3];
+};
+}
+
+// see UIC leaflet 920-14, omitting codes not unambiguously mapping to a single country
+static constexpr const UicCountry uic_country_map[] = {
+    {10, "FI"},
+    {20, "RU"},
+    {21, "BY"},
+    {22, "UA"},
+    {23, "MD"},
+    {24, "LT"},
