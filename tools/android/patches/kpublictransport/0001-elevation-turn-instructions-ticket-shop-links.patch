+/** Point @p dist meters from @p p in direction @p bearing (degrees), sufficiently precise for short distances. */
+[[nodiscard]] static QPointF offset(QPointF p, double bearing, double dist)
+{
+    constexpr double METERS_PER_DEGREE = 111195.0;
+    const auto b = qDegreesToRadians(bearing);
+    return {p.x() + dist * std::sin(b) / (METERS_PER_DEGREE * std::cos(qDegreesToRadians(p.y()))), p.y() + dist * std::cos(b) / METERS_PER_DEGREE};
+}
+
+/** Straight line starting at @p p in direction @p bearing with @p dist meters length. */
+[[nodiscard]] static QPolygonF line(QPointF p, double bearing, double dist)
+{
+    return QPolygonF({p, offset(p, bearing, dist)});
+}
+
+/** Like line(), but with a vertex every 5 meters, as found in real-world data. */
+[[nodiscard]] static QPolygonF denseLine(QPointF p, double bearing, double dist)
+{
+    QPolygonF poly;
+    for (double d = 0.0; d < dist; d += 5.0) {
+        poly.push_back(offset(p, bearing, d));
+    }
+    poly.push_back(offset(p, bearing, dist));
+    return poly;
+}
