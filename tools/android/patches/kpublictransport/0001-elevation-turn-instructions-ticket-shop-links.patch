+    void testPrecedence()
+    {
+        const auto dep = localTime(2026, 11, 20, 8, 0, "Europe/Berlin");
+        const auto generated = makeSection(aachen, gent, dep, u"DB Fernverkehr AG"_s);
+        QCOMPARE(urlString(generated.bookingUrl()), QLatin1StringView(dbUrl));
+
+        // backend URLs win
+        auto section = generated;
+        section.setBookingUrl(QUrl(u"https://backend.example.org/section"_s));
+        QCOMPARE(section.bookingUrl(), QUrl(u"https://backend.example.org/section"_s));
+
+        // rental vehicle URLs win
+        section = generated;
+        RentalVehicle vehicle;
+        vehicle.setAppBookingUrl(QUrl(u"rental://book"_s));
+        section.setRentalVehicle(vehicle);
+        QCOMPARE(section.bookingUrl(), QUrl(u"rental://book"_s));
+
+        Journey journey;
+        journey.setSections({generated});
+        QCOMPARE(urlString(journey.bookingUrl()), QLatin1StringView(dbUrl));
+        journey.setBookingUrl(QUrl(u"https://backend.example.org/journey"_s));
+        QCOMPARE(journey.bookingUrl(), QUrl(u"https://backend.example.org/journey"_s));
+
+        // generated links are not serialized, but are generated again after deserialization
+        const auto sectionJson = JourneySection::toJson(generated);
+        QVERIFY(!sectionJson.contains("bookingUrl"_L1));
+        QCOMPARE(urlString(JourneySection::fromJson(sectionJson).bookingUrl()), QLatin1StringView(dbUrl));
+        journey.setBookingUrl({});
+        const auto journeyJson = Journey::toJson(journey);
+        QVERIFY(!journeyJson.contains("bookingUrl"_L1));
+        QVERIFY(!journeyJson.value("sections"_L1).toArray().at(0).toObject().contains("bookingUrl"_L1));
+        QCOMPARE(urlString(Journey::fromJson(journeyJson).bookingUrl()), QLatin1StringView(dbUrl));
+
+        // generated links must not hide backend links when merging
+        Journey backendJourney;
+        backendJourney.setSections({generated});
+        backendJourney.setBookingUrl(QUrl(u"https://backend.example.org/journey"_s));
+        QCOMPARE(Journey::merge(journey, backendJourney).bookingUrl(), QUrl(u"https://backend.example.org/journey"_s));
+        QCOMPARE(Journey::merge(backendJourney, journey).bookingUrl(), QUrl(u"https://backend.example.org/journey"_s));
+        auto backendSection = generated;
+        backendSection.setBookingUrl(QUrl(u"https://backend.example.org/section"_s));
+        QCOMPARE(JourneySection::merge(generated, backendSection).bookingUrl(), QUrl(u"https://backend.example.org/section"_s));
+        QCOMPARE(JourneySection::merge(backendSection, generated).bookingUrl(), QUrl(u"https://backend.example.org/section"_s));
+    }
+
+    void testJourney()
+    {
+        const auto berlinTz = "Europe/Berlin";
+        const auto frankfurt = makeLocation(u"Frankfurt(Main) Hbf"_s, "DE", berlinTz, {{"ibnr", "8000105"}});
+        const auto koeln = makeLocation(u"Köln Hbf"_s, "DE", berlinTz, {{"ibnr", "8000207"}});
+
+        JourneySection walk;
+        walk.setMode(JourneySection::Walking);
+        walk.setFrom(koeln);
+        walk.setTo(koeln);
+        walk.setScheduledDepartureTime(localTime(2026, 11, 20, 9, 20, berlinTz));
+        walk.setScheduledArrivalTime(localTime(2026, 11, 20, 9, 25, berlinTz));
+
+        // multiple sections sold by the same shop
+        Journey journey;
+        journey.setSections({
+            makeSection(frankfurt, koeln, localTime(2026, 11, 20, 8, 0, berlinTz), u"DB Fernverkehr AG"_s),
+            walk,
+            makeSection(koeln, aachen, localTime(2026, 11, 20, 9, 30, berlinTz), u"DB Regio AG"_s, Line::LocalTrain),
+        });
+        QCOMPARE(urlString(journey.bookingUrl()), "https://www.bahn.de/buchung/fahrplan/suche#sts=true&so=Frankfurt%28Main%29%20Hbf&zo=Aachen%20Hbf&kl=2&r=13:16:KLASSENLOS:1&soid=A%3D1%40O%3DFrankfurt%28Main%29%20Hbf%40L%3D8000105%40&zoid=A%3D1%40O%3DAachen%20Hbf%40L%3D8000001%40&sot=ST&zot=ST&soei=8000105&zoei=8000001&hd=2026-11-20T08:00:00&hza=D&ar=false&s=true&d=false&fm=false&bp=false"_L1);
+        QCOMPARE(urlString(journey.sections()[0].bookingUrl()), "https://www.bahn.de/buchung/fahrplan/suche#sts=true&so=Frankfurt%28Main%29%20Hbf&zo=K%C3%B6ln%20Hbf&kl=2&r=13:16:KLASSENLOS:1&soid=A%3D1%40O%3DFrankfurt%28Main%29%20Hbf%40L%3D8000105%40&zoid=A%3D1%40O%3DK%C3%B6ln%20Hbf%40L%3D8000207%40&sot=ST&zot=ST&soei=8000105&zoei=8000207&hd=2026-11-20T08:00:00&hza=D&ar=false&s=true&d=false&fm=false&bp=false"_L1);
+        QVERIFY(journey.sections()[1].bookingUrl().isEmpty());
+        QCOMPARE(urlString(journey.sections()[2].bookingUrl()), "https://www.bahn.de/buchung/fahrplan/suche#sts=true&so=K%C3%B6ln%20Hbf&zo=Aachen%20Hbf&kl=2&r=13:16:KLASSENLOS:1&soid=A%3D1%40O%3DK%C3%B6ln%20Hbf%40L%3D8000207%40&zoid=A%3D1%40O%3DAachen%20Hbf%40L%3D8000001%40&sot=ST&zot=ST&soei=8000207&zoei=8000001&hd=2026-11-20T09:30:00&hza=D&ar=false&s=true&d=false&fm=false&bp=false"_L1);
+
+        // one section with a backend provided link: no generated link for the entire journey
+        auto sections = journey.sections();
+        sections[2].setBookingUrl(QUrl(u"https://backend.example.org/section"_s));
+        Journey backendJourney;
+        backendJourney.setSections(std::move(sections));
+        QVERIFY(backendJourney.bookingUrl().isEmpty());
+
+        // rental vehicle sections: no generated link for the entire journey
+        sections = journey.sections();
+        sections[1].setMode(JourneySection::RentedVehicle);
+        Journey rentalJourney;
+        rentalJourney.setSections(std::move(sections));
+        QVERIFY(rentalJourney.bookingUrl().isEmpty());
+
+        // single public transport section with walks around it
+        Journey singleJourney;
+        singleJourney.setSections({walk, journey.sections()[2], walk});
+        QCOMPARE(singleJourney.bookingUrl(), journey.sections()[2].bookingUrl());
+        QVERIFY(!singleJourney.bookingUrl().isEmpty());
+
+        // cross-border with different operators, still sold by one shop
+        const auto zurichTz = "Europe/Zurich";
+        const auto zuerich = makeLocation(u"Zürich HB"_s, "CH", zurichTz, {{"uic", "8503000"}, {"ibnr", "8503000"}});
+        const auto basel = makeLocation(u"Basel SBB"_s, "CH", zurichTz, {{"uic", "8500010"}, {"ibnr", "8500010"}});
+        const auto freiburg = makeLocation(u"Freiburg(Breisgau) Hbf"_s, "DE", berlinTz, {{"ibnr", "8000107"}});
+        Journey chJourney;
+        chJourney.setSections({
+            makeSection(zuerich, basel, localTime(2026, 11, 20, 8, 0, zurichTz), u"SBB"_s),
+            makeSection(basel, freiburg, localTime(2026, 11, 20, 9, 30, zurichTz), u"DB Regio AG"_s, Line::LocalTrain),
+        });
+        QCOMPARE(urlString(chJourney.bookingUrl()), "https://www.bahn.de/buchung/fahrplan/suche#sts=true&so=Z%C3%BCrich%20HB&zo=Freiburg%28Breisgau%29%20Hbf&kl=2&r=13:16:KLASSENLOS:1&soid=A%3D1%40O%3DZ%C3%BCrich%20HB%40L%3D8503000%40&zoid=A%3D1%40O%3DFreiburg%28Breisgau%29%20Hbf%40L%3D8000107%40&sot=ST&zot=ST&soei=8503000&zoei=8000107&hd=2026-11-20T08:00:00&hza=D&ar=false&s=true&d=false&fm=false&bp=false"_L1);
+        QVERIFY(urlString(chJourney.sections()[0].bookingUrl()).startsWith("https://www.sbb.ch/"_L1));
+
+        // different operators not sold by a single shop
+        QLocale::setDefault(QLocale(u"en_GB"_s));
+        const auto london = makeLocation(u"London St Pancras International"_s, "GB", "Europe/London", {{"uic", "7015400"}});
+        const auto bruxelles = makeLocation(u"Bruxelles-Midi"_s, "BE", "Europe/Brussels", {{"uic", "8814001"}});
+        Journey esJourney;
+        esJourney.setSections({
+            makeSection(london, bruxelles, localTime(2026, 11, 20, 8, 0, "Europe/London"), u"Eurostar"_s),
+            makeSection(bruxelles, gent, localTime(2026, 11, 20, 12, 30, "Europe/Brussels"), u"SNCB"_s),
+        });
+        QVERIFY(esJourney.bookingUrl().isEmpty());
+        QCOMPARE(urlString(esJourney.sections()[0].bookingUrl()), "https://www.eurostar.com/search/uk-en?adult=1&origin=7015400&destination=8814001&outbound=2026-11-20"_L1);
+        QVERIFY(esJourney.sections()[1].bookingUrl().isEmpty());
+    }
+};
+
+QTEST_GUILESS_MAIN(TicketShopTest)
