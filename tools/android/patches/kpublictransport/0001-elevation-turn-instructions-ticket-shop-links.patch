+            auto s4 = makeSection(p4, u"B"_s);
+            s4.setElevationProfile(QPolygonF({{0.0, 90.0}, {50.0, 100.0}}));
+            auto s5 = makeSection(p5, u"B"_s);
+            // the jump from 100 to 101 isn't counted when summing up per section
+            s5.setElevationProfile(QPolygonF({{0.0, 101.0}, {50.0, 98.0}}));
+            auto s6 = makeSection(p6, u"B"_s);
+            s6.setAscent(7);
+
+            Path path;
+            path.setSections({s1, s2, s3, s4, s5, s6});
+            QCOMPARE(path.ascent(), 3 + 2 + 10 + 0 + 7);
+            QCOMPARE(path.descent(), 1 + 0 + 3);
+            const auto profile = path.elevationProfile();
+            QCOMPARE(profile.size(), 4);
+            QCOMPARE(profile[0], QPointF(103.0, 90.0));
+
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.ascent(), 3 + 2 + 10 + 0 + 7);
+            QCOMPARE(path.descent(), 1 + 0 + 3);
+            QCOMPARE(path.elevationProfile(), profile);
+
+            QCOMPARE(path.sections()[0].ascent(), 5);
+            QCOMPARE(path.sections()[0].descent(), 1);
+            QVERIFY(!path.sections()[0].hasElevationProfile());
+            QCOMPARE(path.sections()[1].ascent(), 17);
+            QCOMPARE(path.sections()[1].descent(), 3);
+            QCOMPARE(path.sections()[1].elevationProfile(), QPolygonF({{0.0, 90.0}, {50.0, 100.0}, {50.0, 101.0}, {100.0, 98.0}}));
+
+            // survives serialization
+            const auto path2 = Path::fromJson(Path::toJson(path));
+            QCOMPARE(path2.ascent(), path.ascent());
+            QCOMPARE(path2.descent(), path.descent());
+            QCOMPARE(path2.elevationProfile(), profile);
+        }
+
+        // explicit values take precedence over the profile of a section, also on the path level
+        {
+            auto s1 = makeSection(line(Berlin, 0.0, 50.0));
+            s1.setElevationProfile(QPolygonF({{0.0, 100.0}, {50.0, 110.0}}));
+            s1.setAscent(12);
+            Path path;
+            path.setSections({s1});
+            QCOMPARE(path.ascent(), 12);
+            QCOMPARE(path.descent(), 0);
+        }
+    }
