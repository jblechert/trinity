+/*
+    SPDX-FileCopyrightText: 2026 Janis Blechert <janis@blechert.at>
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#include "pathutil_p.h"
+#include "location.h"
+#include "path.h"
+
+#include <QPolygonF>
+#include <QtMath>
+
+#include <cmath>
+
+using namespace KPublicTransport;
+
+/** Distance along the path used for determining start/end bearings, in meters. */
+constexpr inline double BEARING_MEASURE_DISTANCE = 15.0;
+/** Minimum length of a path to have a meaningful bearing, in meters. */
+constexpr inline double BEARING_MIN_LENGTH = 0.5;
+/** Maximum length of an unnamed connector section to be merged into its predecessor, in meters. */
+constexpr inline int SHORT_CONNECTOR_MAX_LENGTH = 5;
+
+[[nodiscard]] static double distance(QPointF p1, QPointF p2)
+{
+    return Location::distance(p1.y(), p1.x(), p2.y(), p2.x());
+}
+
+double PathUtil::bearing(QPointF from, QPointF to)
+{
+    const auto phi1 = qDegreesToRadians(from.y());
+    const auto phi2 = qDegreesToRadians(to.y());
+    const auto deltaLambda = qDegreesToRadians(to.x() - from.x());
+    const auto theta = std::atan2(std::sin(deltaLambda) * std::cos(phi2),
+                                  std::cos(phi1) * std::sin(phi2) - std::sin(phi1) * std::cos(phi2) * std::cos(deltaLambda));
+    const auto b = std::fmod(qRadiansToDegrees(theta) + 360.0, 360.0);
+    return b >= 360.0 ? 0.0 : b;
+}
+
+/** Bearing from the first point in [begin, end) to the first point at least BEARING_MEASURE_DISTANCE away along the line,
+ *  or the last point if the line is shorter than that.
+ *  With @p reverse this is used on reverse iterators, and computes the bearing towards the first point instead.
+ */
+template <typename Iter>
+[[nodiscard]] static std::optional<double> measureBearing(Iter begin, Iter end, bool reverse)
+{
+    if (std::distance(begin, end) < 2) {
+        return {};
+    }
+
+    double length = 0.0;
+    for (auto it = std::next(begin); it != end; ++it) {
+        length += distance(*std::prev(it), *it);
+        if (length >= BEARING_MEASURE_DISTANCE) {
+            return reverse ? PathUtil::bearing(*it, *begin) : PathUtil::bearing(*begin, *it);
+        }
+    }
+    if (length < BEARING_MIN_LENGTH) {
+        return {};
+    }
+    const auto last = std::prev(end);
+    return reverse ? PathUtil::bearing(*last, *begin) : PathUtil::bearing(*begin, *last);
+}
+
+std::optional<double> PathUtil::startBearing(const QPolygonF &path)
+{
+    return measureBearing(path.begin(), path.end(), false);
+}
+
+std::optional<double> PathUtil::endBearing(const QPolygonF &path)
+{
+    return measureBearing(path.rbegin(), path.rend(), true);
+}
+
+/** Append the path of @p from to @p to, without duplicating the junction point.
+ *  Elevation information are merged as well, see PathUtil::appendElevation.
+ */
+static void appendPath(PathSection &to, const PathSection &from, bool elevationProfilesOnly)
+{
+    PathUtil::appendElevation(to, from, elevationProfilesOnly);
+
+    auto path = to.path();
+    const auto &tail = from.path();
+    auto it = tail.begin();
+    if (!path.isEmpty() && it != tail.end() && path.constLast() == *it) {
+        ++it;
+    }
+    path.reserve(path.size() + std::distance(it, tail.end()));
+    std::copy(it, tail.end(), std::back_inserter(path));
+    to.setPath(path);
+}
+
+/** Checks whether @p sec is a plain movement section without any backend-provided description. */
+[[nodiscard]] static bool isPlainMove(const PathSection &sec)
+{
+    return sec.maneuver() == PathSection::Move && sec.floorLevelChange() == 0 && sec.description().isEmpty();
+}
+
+/** Merge sections for which @p canMerge returns @c true into their predecessor. */
+template <typename Pred>
+static void mergeIf(std::vector<PathSection> &sections, Pred canMerge)
+{
+    if (sections.size() < 2) {
+        return;
+    }
+
+    const auto elevationProfilesOnly = PathUtil::hasOnlyElevationProfiles(sections);
+    std::vector<PathSection> result;
+    result.reserve(sections.size());
+    for (auto &sec : sections) {
+        if (!result.empty() && canMerge(result.back(), sec)) {
+            appendPath(result.back(), sec, elevationProfilesOnly);
+        } else {
+            result.push_back(std::move(sec));
+        }
+    }
+    sections = std::move(result);
+}
+
+/** Checks whether @p sec is a short unnamed connector to be absorbed into @p prev. */
+[[nodiscard]] static bool isShortConnector(const PathSection &prev, const PathSection &sec)
+{
+    return isPlainMove(prev) && isPlainMove(sec)
+        && sec.streetName().isEmpty()
+        && sec.turnDirection() == PathSection::UnknownTurnDirection
+        && sec.distance() < SHORT_CONNECTOR_MAX_LENGTH;
+}
+
+void PathUtil::absorbShortConnectors(std::vector<PathSection> &sections)
+{
+    if (sections.size() < 2) {
+        return;
+    }
+
+    const auto elevationProfilesOnly = PathUtil::hasOnlyElevationProfiles(sections);
+    std::vector<PathSection> result;
+    result.reserve(sections.size());
+    // end bearing of result.back() before any connectors were absorbed into it
+    std::optional<double> anchorBearing;
+    bool hasAbsorbed = false;
+    for (auto &sec : sections) {
+        if (!result.empty() && isShortConnector(result.back(), sec)) {
+            if (!hasAbsorbed) {
+                anchorBearing = endBearing(result.back().path());
+                hasAbsorbed = true;
+            }
+            appendPath(result.back(), sec, elevationProfilesOnly);
+            continue;
+        }
+
+        // the turn into the section following absorbed connectors is measured from the section
+        // before the connectors, as the connectors themselves might make up (part of) the turn
+        // which would then no longer be visible in the end bearing of the merged section
+        if (hasAbsorbed && anchorBearing && sec.maneuver() == PathSection::Move && sec.turnDirection() == PathSection::UnknownTurnDirection) {
+            if (const auto bearing = startBearing(sec.path()); bearing) {
+                sec.setTurnDirection(PathSection::turnDirectionFromAngle(*bearing - *anchorBearing));
+            }
+        }
+        hasAbsorbed = false;
+        anchorBearing.reset();
+        result.push_back(std::move(sec));
+    }
+    sections = std::move(result);
+}
+
+void PathUtil::fillTurnDirections(std::vector<PathSection> &sections)
+{
+    for (std::size_t i = 1; i < sections.size(); ++i) {
+        auto &sec = sections[i];
+        if (sec.maneuver() != PathSection::Move || sec.turnDirection() != PathSection::UnknownTurnDirection) {
+            continue;
+        }
+        const auto prevBearing = endBearing(sections[i - 1].path());
+        const auto bearing = startBearing(sec.path());
+        if (prevBearing && bearing) {
+            sec.setTurnDirection(PathSection::turnDirectionFromAngle(*bearing - *prevBearing));
+        }
+    }
+}
+
+void PathUtil::mergeSections(std::vector<PathSection> &sections)
+{
+    mergeIf(sections, [](const PathSection &prev, const PathSection &sec) {
+        if (!isPlainMove(prev) || !isPlainMove(sec)) {
+            return false;
+        }
+        if (prev.hasStartFloorLevel() && sec.hasStartFloorLevel() && prev.startFloorLevel() != sec.startFloorLevel()) {
+            return false;
+        }
+        // continuing straight onto an unnamed way doesn't need an instruction either
+        // (e.g. a street name ending, or a generic name dropped by the backend)
+        if (prev.streetName() != sec.streetName()) {
+            return sec.streetName().isEmpty() && sec.turnDirection() == PathSection::Straight;
+        }
+        switch (sec.turnDirection()) {
+            case PathSection::Straight:
+                return true;
+            case PathSection::SlightLeft:
+            case PathSection::SlightRight:
+                // following a named street through a slight bend doesn't need an instruction,
+                // a slight turn onto another unnamed way however might be relevant
+                return !sec.streetName().isEmpty();
+            default:
+                return false;
+        }
+    });
+}
