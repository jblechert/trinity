+/** Clean up the elevation profile of a single step or leg.
+ *  Distances in OTP elevation profiles are relative to the start of the step or leg in theory,
+ *  but in practice they can be offset, restart in the middle of the step when
+ *  the step consists of multiple edges, or exceed the length of the step or leg.
+ *  The result starts at 0, is monotonic and doesn't exceed @p length (if known).
+ */
+[[nodiscard]] static QPolygonF normalizeElevationProfile(const QPolygonF &rawProfile, double length)
+{
+    QPolygonF profile;
+    profile.reserve(rawProfile.size());
+    double offset = 0.0;
+    for (auto p : rawProfile) {
+        if (profile.empty()) {
+            offset = -p.x();
+        } else if (p.x() + offset < profile.constLast().x()) {
+            offset = profile.constLast().x() - p.x();
+        }
+        p.setX(p.x() + offset);
+        if (length > 0.0) {
+            p.setX(std::min(p.x(), length));
+        }
+        p.setX(std::round(p.x() * 100.0) / 100.0);
+        profile.push_back(p);
+    }
