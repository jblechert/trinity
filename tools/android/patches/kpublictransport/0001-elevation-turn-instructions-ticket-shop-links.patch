+    {87, "FR"},
+    {88, "BE"},
+    {90, "EG"},
+    {91, "TN"},
+    {92, "DZ"},
+    {93, "MA"},
+    {94, "PT"},
+    {95, "IL"},
+    {96, "IR"},
+    {97, "SY"},
+    {98, "LB"},
+    {99, "IQ"},
+};
+
+QString UicStationCode::isoCountry(QStringView id)
+{
+    while (id.size() > 7 && id.front() == QLatin1Char('0')) {
+        id = id.mid(1);
+    }
+    if (!isValid(id)) {
+        return {};
+    }
+
+    const auto uicCode = country(id).toInt();
+    const auto it = std::lower_bound(std::begin(uic_country_map), std::end(uic_country_map), uicCode, [](const auto &lhs, auto rhs) {
+        return lhs.uicCode < rhs;
+    });
+    if (it == std::end(uic_country_map) || (*it).uicCode != uicCode) {
+        return {};
+    }
+    return QString::fromLatin1((*it).isoCode, 2);
+}
