+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#ifndef KPUBLICTRANSPORT_TICKETSHOP_P_H
+#define KPUBLICTRANSPORT_TICKETSHOP_P_H
+
+#include "kpublictransport_export.h"
+
+#include <QExplicitlySharedDataPointer>
+#include <QUrl>
+
+#include <cstdint>
+#include <vector>
+
+class QDateTime;
+class QJsonObject;
+class QString;
+
+namespace KPublicTransport {
+
+class Journey;
+class JourneySection;
+class Location;
+class TicketShopPrivate;
+
+/** A ticket shop we know how to generate search/booking deep links for.
+ *  Shops are described in networks/booking/ticket-shops.json, see the README.md there.
+ *  @internal only exported for unit tests
+ */
+class KPUBLICTRANSPORT_EXPORT TicketShop
+{
+public:
+    TicketShop();
+    TicketShop(const TicketShop &);
+    TicketShop(TicketShop &&) noexcept;
+    ~TicketShop();
+    TicketShop &operator=(const TicketShop &);
+    TicketShop &operator=(TicketShop &&) noexcept;
+
+    /** How well a shop matches a journey section. */
+    enum Match : uint8_t {
+        NoMatch = 0, ///< shop does not sell tickets for this
+        GenericMatch = 1, ///< shop sells tickets for this region/mode
+        OperatorMatch = 2, ///< shop is explicitly listed for the operator of this section
+    };
+
+    [[nodiscard]] bool isValid() const;
+    [[nodiscard]] QString id() const;
+
+    /** Checks whether this shop sells tickets for @p section. */
+    [[nodiscard]] Match matchSection(const JourneySection &section) const;
+    /** Checks the country requirements for the start and end of a trip. */
+    [[nodiscard]] bool matchEndpoints(const Location &from, const Location &to) const;
+
+    /** Expands the URL template of this shop.
+     *  @returns an empty URL if any placeholder cannot be resolved.
+     */
+    [[nodiscard]] QUrl bookingUrl(const Location &from, const Location &to, const QDateTime &departure, const QDateTime &arrival) const;
+
+    /** Parse a shop definition.
+     *  @returns an invalid shop if any load-time check fails.
+     */
+    [[nodiscard]] static TicketShop fromJson(const QJsonObject &obj);
+
+private:
+    QExplicitlySharedDataPointer<TicketShopPrivate> d;
+};
+
+/** Access to the ticket shop table. */
+namespace TicketShops
+{
+/** Load all valid shop definitions from @p fileName. */
+[[nodiscard]] KPUBLICTRANSPORT_EXPORT std::vector<TicketShop> loadFromFile(const QString &fileName);
+
+/** All known shops, loaded on first use from networks/booking/ticket-shops.json. */
+[[nodiscard]] KPUBLICTRANSPORT_EXPORT std::vector<TicketShop> shops();
+
+/** Discard the loaded shop table, e.g. following an online update. */
+KPUBLICTRANSPORT_EXPORT void reload();
+
+/** Generated deep link for a single journey section, if any shop matches. */
+[[nodiscard]] KPUBLICTRANSPORT_EXPORT QUrl bookingUrl(const JourneySection &section);
+
+/** Generated deep link covering all public transport sections of @p journey,
+ *  if a single shop sells all of them.
+ *  Other sections are ignored, it is up to the caller to decide whether a single
+ *  link for the entire journey makes sense (see Journey::bookingUrl).
+ */
+[[nodiscard]] KPUBLICTRANSPORT_EXPORT QUrl bookingUrl(const Journey &journey);
+}
+
+}
+
+#endif // KPUBLICTRANSPORT_TICKETSHOP_P_H
