+class TicketShopTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+        QLocale::setDefault(QLocale(u"en_US"_s));
+    }
+
+    void cleanup()
+    {
+        QLocale::setDefault(QLocale(u"en_US"_s));
+    }
+
+    void testTable()
+    {
+        QFile f(sourceTable());
+        QVERIFY(f.open(QFile::ReadOnly));
+        const auto raw = QJsonDocument::fromJson(f.readAll()).object().value("shops"_L1).toArray();
+        QVERIFY(!raw.isEmpty());
+
+        // no entry is dropped
+        const auto shops = TicketShops::loadFromFile(sourceTable());
+        QCOMPARE(shops.size(), raw.size());
+        // the built-in table is the same
+        QCOMPARE(TicketShops::shops().size(), shops.size());
+
+        QSet<QString> ids;
+        QString prevId;
+        static const QRegularExpression idRx(u"^[a-z]{2}_[a-z0-9]+$"_s);
+        for (const auto &shop : shops) {
+            QVERIFY(shop.isValid());
+            QVERIFY(idRx.match(shop.id()).hasMatch());
+            QVERIFY2(prevId < shop.id(), qPrintable(shop.id())); // sorted and unique
+            prevId = shop.id();
+            ids.insert(shop.id());
+        }
+
+        // every shop has a golden test
+        QSet<QString> goldenIds;
+        for (const auto &row : goldenRows()) {
+            goldenIds.insert(QString::fromLatin1(row.shopId));
+        }
+        QCOMPARE(goldenIds, ids);
+    }
+
+    void testGolden_data()
+    {
+        QTest::addColumn<QString>("shopId");
+        QTest::addColumn<Location>("from");
+        QTest::addColumn<Location>("to");
+        QTest::addColumn<QDateTime>("departure");
+        QTest::addColumn<QString>("operatorName");
+        QTest::addColumn<Line::Mode>("mode");
+        QTest::addColumn<QString>("locale");
+        QTest::addColumn<QString>("expected");
+
+        for (const auto &row : goldenRows()) {
+            QTest::newRow(row.rowName) << QString::fromLatin1(row.shopId) << row.from << row.to << row.departure << row.operatorName << row.mode
+                                       << QString::fromLatin1(row.locale) << QString::fromLatin1(row.expected);
+        }
+    }
+
+    void testGolden()
+    {
+        QFETCH(QString, shopId);
+        QFETCH(Location, from);
+        QFETCH(Location, to);
+        QFETCH(QDateTime, departure);
+        QFETCH(QString, operatorName);
+        QFETCH(Line::Mode, mode);
+        QFETCH(QString, locale);
+        QFETCH(QString, expected);
+
+        if (!locale.isEmpty()) {
+            QLocale::setDefault(QLocale(locale));
+        }
+
+        const auto section = makeSection(from, to, departure, operatorName, mode);
+        QCOMPARE(urlString(TicketShops::bookingUrl(section)), expected);
+        QCOMPARE(urlString(section.bookingUrl()), expected);
+
+        // the expected shop produced this
+        const auto shop = findShop(TicketShops::shops(), shopId);
+        QVERIFY(shop.isValid());
+        QVERIFY(shop.matchSection(section) != TicketShop::NoMatch);
+        QCOMPARE(urlString(shop.bookingUrl(from, to, section.scheduledDepartureTime(), section.scheduledArrivalTime())), expected);
+    }
+
+    void testTemplate()
+    {
+        const auto dep = localTime(2026, 11, 20, 8, 0, "Europe/Berlin");
+        auto from = makeLocation(u"A/B & C+D #1 ?x"_s, "DE", "Europe/Berlin");
+        auto to = makeLocation(u"Say \"hi\" \\ there"_s, "DE", "Europe/Berlin");
+
+        // encoding
+        auto shop = makeShop(u"https://example.org/?q={from.name}"_s);
+        QVERIFY(shop.isValid());
+        QCOMPARE(urlString(shop.bookingUrl(from, to, dep, dep)), "https://example.org/?q=A%2FB%20%26%20C%2BD%20%231%20%3Fx"_L1);
+        shop = makeShop(u"https://example.org/?q={from.name|plus}"_s);
+        QCOMPARE(urlString(shop.bookingUrl(from, to, dep, dep)), "https://example.org/?q=A%2FB+%26+C%2BD+%231+%3Fx"_L1);
+
+        // json
+        shop = makeShop(u"https://example.org/?data=%7B%22n%22%3A%22{to.name|json}%22%7D"_s);
+        QCOMPARE(urlString(shop.bookingUrl(from, to, dep, dep)), "https://example.org/?data=%7B%22n%22%3A%22Say%20%5C%22hi%5C%22%20%5C%5C%20there%22%7D"_L1);
+
+        // slug
+        shop = makeShop(u"https://example.org/{from.name|slug}/{to.name|slug}"_s);
+        from.setName(u"Timișoara Nord"_s);
+        to.setName(u"Cluj-Napoca"_s);
+        QCOMPARE(urlString(shop.bookingUrl(from, to, dep, dep)), "https://example.org/Timisoara-Nord/Cluj-Napoca"_L1);
+        to.setName(u"Satu  Mare"_s);
+        QCOMPARE(urlString(shop.bookingUrl(from, to, dep, dep)), "https://example.org/Timisoara-Nord/Satu-Mare"_L1);
+
+        // lower
+        shop = makeShop(u"https://example.org/{from.country|lower}/{to.name|slug|lower}"_s);
+        QCOMPARE(urlString(shop.bookingUrl(from, to, dep, dep)), "https://example.org/de/satu-mare"_L1);
+
+        // minutes of day
+        shop = makeShop(u"https://example.org/?m={departure.minutesOfDay}"_s);
+        QCOMPARE(urlString(shop.bookingUrl(from, to, localTime(2026, 11, 20, 0, 0, "Europe/Berlin"), dep)), "https://example.org/?m=0"_L1);
+        QCOMPARE(urlString(shop.bookingUrl(from, to, localTime(2026, 11, 20, 23, 59, "Europe/Berlin"), dep)), "https://example.org/?m=1439"_L1);
+
+        // arrival uses the destination time zone
+        shop = makeShop(u"https://example.org/?d={departure:HH'%3A'mm}&a={arrival:HH'%3A'mm}"_s);
+        const auto london = makeLocation(u"London"_s, "GB", "Europe/London");
+        const auto paris = makeLocation(u"Paris"_s, "FR", "Europe/Paris");
+        QCOMPARE(urlString(shop.bookingUrl(london, paris, QDateTime({2026, 11, 20}, {8, 0}, QTimeZone::UTC), QDateTime({2026, 11, 20}, {10, 30}, QTimeZone::UTC))),
+                 "https://example.org/?d=08%3A00&a=11%3A30"_L1);
+        // missing times
+        QVERIFY(shop.bookingUrl(london, paris, {}, dep).isEmpty());
+        QVERIFY(shop.bookingUrl(london, paris, dep, {}).isEmpty());
+
+        // date rollover
+        const auto cfr = findShop(TicketShops::loadFromFile(sourceTable()), u"ro_cfr");
+        QVERIFY(cfr.isValid());
+        const auto bucuresti = makeLocation(u"București Nord"_s, "RO", "Europe/Bucharest");
+        const auto brasov = makeLocation(u"Brașov"_s, "RO", "Europe/Bucharest");
+        QCOMPARE(urlString(cfr.bookingUrl(bucuresti, brasov, QDateTime({2026, 11, 20}, {22, 30}, QTimeZone::UTC), {})),
+                 "https://bilete.cfrcalatori.ro/ro-RO/Rute-trenuri/Bucuresti-Nord/Brasov?DepartureDate=21.11.2026&MinutesInDay=30"_L1);
+
+        // floating time is used unchanged
+        QCOMPARE(urlString(cfr.bookingUrl(bucuresti, brasov, QDateTime({2026, 11, 20}, {8, 0}), {})),
+                 "https://bilete.cfrcalatori.ro/ro-RO/Rute-trenuri/Bucuresti-Nord/Brasov?DepartureDate=20.11.2026&MinutesInDay=480"_L1);
+
+        // parts of station identifiers
+        const QJsonObject captureRules{{"stationIdentifiers"_L1, QJsonArray{
+            QJsonObject{{"type"_L1, "uic"_L1}, {"pattern"_L1, "^80([0-9]{5})$"_L1}, {"uicCountries"_L1, QJsonArray{80}}},
+            QJsonObject{{"type"_L1, "feed"_L1}, {"pattern"_L1, "^de-feed_([A-Z]+)(?:_[0-9]+)?$"_L1}, {"aliases"_L1, QJsonObject{{"de-feed_X"_L1, "de-feed_Y"_L1}}}},
+        }}};
+        shop = makeShop(u"https://example.org/{from.id|capture}/{to.id|capture|lower}?full={from.id}"_s, captureRules);
+        QVERIFY(shop.isValid());
+        from = makeLocation(u"A"_s, "DE", "Europe/Berlin", {{"uic", "8000105"}, {"feed", "de-feed_FF_1"}});
+        to = makeLocation(u"B"_s, "DE", "Europe/Berlin", {{"feed", "de-feed_KK_2"}});
+        QCOMPARE(urlString(shop.bookingUrl(from, to, dep, dep)), "https://example.org/00105/kk?full=8000105"_L1);
+        // the first matching rule is used, aliases are applied before matching
+        from = makeLocation(u"A"_s, "DE", "Europe/Berlin", {{"uic", "801234"}, {"feed", "de-feed_X"}});
+        QCOMPARE(urlString(shop.bookingUrl(from, to, dep, dep)), "https://example.org/Y/kk?full=de-feed_Y"_L1);
+        from = makeLocation(u"A"_s, "DE", "Europe/Berlin", {{"uic", "8112345"}});
+        QVERIFY(shop.bookingUrl(from, to, dep, dep).isEmpty());
+
+        // unresolvable placeholders
+        shop = makeShop(u"https://example.org/{from.id}"_s, {{"stationIdentifiers"_L1, QJsonArray{QJsonObject{{"type"_L1, "uic"_L1}}}}});
+        QVERIFY(shop.isValid());
+        QVERIFY(shop.bookingUrl(london, paris, dep, dep).isEmpty());
+        QVERIFY(shop.bookingUrl(Location(), paris, dep, dep).isEmpty());
+    }
