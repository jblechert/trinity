+using IdList = std::initializer_list<std::pair<const char *, const char *>>;
+
+[[nodiscard]] static Location makeLocation(const QString &name, const char *country, const char *tz, IdList ids = {})
+{
+    Location loc;
+    loc.setName(name);
+    loc.setCountry(QString::fromLatin1(country));
+    loc.setTimeZone(QTimeZone(tz));
+    for (const auto &[type, id] : ids) {
+        loc.setIdentifier(QString::fromLatin1(type), QString::fromUtf8(id));
+    }
+    return loc;
+}
+
+[[nodiscard]] static JourneySection makeSection(const Location &from, const Location &to, const QDateTime &dep, const QString &operatorName, Line::Mode mode = Line::LongDistanceTrain, const QUrl &operatorUrl = {})
+{
+    Line line;
+    line.setMode(mode);
+    line.setOperatorName(operatorName);
+    line.setOperatorUrl(operatorUrl);
+    Route route;
+    route.setLine(line);
+
+    JourneySection section;
+    section.setMode(JourneySection::PublicTransport);
+    section.setFrom(from);
+    section.setTo(to);
+    section.setScheduledDepartureTime(dep);
+    section.setScheduledArrivalTime(dep.addSecs(2 * 3600));
+    section.setRoute(route);
+    return section;
+}
+
+[[nodiscard]] static QDateTime localTime(int year, int month, int day, int hour, int minute, const char *tz)
+{
+    return QDateTime({year, month, day}, {hour, minute}, QTimeZone(tz));
+}
+
+[[nodiscard]] static QString urlString(const QUrl &url)
+{
+    return url.toString(QUrl::FullyEncoded);
+}
+
+[[nodiscard]] static QString sourceTable()
+{
+    return QStringLiteral(SOURCE_DIR "/../src/lib/networks/booking/ticket-shops.json");
+}
+
+[[nodiscard]] static TicketShop findShop(const std::vector<TicketShop> &shops, QStringView id)
+{
+    const auto it = std::ranges::find_if(shops, [id](const auto &shop) { return shop.id() == id; });
+    return it != shops.end() ? *it : TicketShop();
+}
+
+/** Minimal inline shop definition for testing template features. */
+[[nodiscard]] static TicketShop makeShop(const QString &url, const QJsonObject &extra = {})
+{
+    QJsonObject obj{
+        {"id"_L1, "xx_test"_L1},
+        {"name"_L1, "Test"_L1},
+        {"match"_L1, QJsonObject{{"countries"_L1, QJsonArray{"DE"_L1, "FR"_L1, "GB"_L1}}}},
+        {"url"_L1, url},
+    };
+    for (auto it = extra.begin(); it != extra.end(); ++it) {
+        obj.insert(it.key(), it.value());
+    }
+    return TicketShop::fromJson(obj);
+}
