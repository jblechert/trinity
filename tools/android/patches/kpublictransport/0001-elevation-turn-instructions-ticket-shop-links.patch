+PathSection::TurnDirection PathSection::turnDirectionFromAngle(double angle)
+{
+    if (!std::isfinite(angle)) {
+        return PathSection::UnknownTurnDirection;
+    }
+
+    // normalize to (-180, 180]
+    angle = std::fmod(angle, 360.0);
+    if (angle > 180.0) {
+        angle -= 360.0;
+    } else if (angle <= -180.0) {
+        angle += 360.0;
+    }
+
+    const auto absAngle = std::abs(angle);
+    const bool right = angle > 0.0;
+    if (absAngle <= STRAIGHT_MAX_ANGLE) {
+        return PathSection::Straight;
+    }
+    if (absAngle <= SLIGHT_TURN_MAX_ANGLE) {
+        return right ? PathSection::SlightRight : PathSection::SlightLeft;
+    }
+    if (absAngle <= TURN_MAX_ANGLE) {
+        return right ? PathSection::Right : PathSection::Left;
+    }
+    if (absAngle <= SHARP_TURN_MAX_ANGLE) {
