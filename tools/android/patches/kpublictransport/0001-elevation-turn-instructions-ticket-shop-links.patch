+    void testPathModel()
+    {
+        auto p1 = line(Berlin, 0.0, 50.0);
+        auto p2 = line(p1.back(), 90.0, 50.0);
+        auto p3 = line(p2.back(), 60.0, 50.0);
+        auto withTurn = makeSection(p3, u"B"_s);
+        withTurn.setTurnDirection(PathSection::SlightLeft);
+        Path path;
+        path.setSections({makeSection(p1), makeSection(p2, u"A"_s), withTurn});
+
+        PathModel model;
+        model.setPath(path);
+        QCOMPARE(model.rowCount(), 3);
+        QVERIFY(model.roleNames().values().contains("instruction"));
+
+        // geometric turn angle without turn direction
+        QCOMPARE(model.index(0, 0).data(PathModel::TurnDirectionRole).toInt(), 0);
+        QCOMPARE(model.index(1, 0).data(PathModel::TurnDirectionRole).toInt(), 90);
+        // canonical angle for the turn direction
+        QCOMPARE(model.index(2, 0).data(PathModel::TurnDirectionRole).toInt(), 315);
+
+        QCOMPARE(model.index(0, 0).data(PathModel::InstructionRole).toString(), "Head north"_L1);
+        QCOMPARE(model.index(1, 0).data(PathModel::InstructionRole).toString(), "Head east on A"_L1);
+        QCOMPARE(model.index(2, 0).data(PathModel::InstructionRole).toString(), "Slight left onto B"_L1);
+
+        path.prepareForNavigation();
+        model.setPath(path);
+        QCOMPARE(model.index(1, 0).data(PathModel::TurnDirectionRole).toInt(), 90);
+        QCOMPARE(model.index(1, 0).data(PathModel::InstructionRole).toString(), "Turn right onto A"_L1);
+    }
+
+    void testArrivalInstruction()
+    {
+        QCOMPARE(PathSection::arrivalInstruction(), "Arrive at destination"_L1);
+        QCOMPARE(PathSection::arrivalInstruction(u"Hauptbahnhof"_s), "Arrive at Hauptbahnhof"_L1);
+    }
+};
