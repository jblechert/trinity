+        pathSec.setPath(QPolygonF({{8.0, 49.0}, {8.0, 49.001}}));
+        pathSec.setElevationProfile(QPolygonF({{0.0, 100.0}, {50.0, 110.0}, {111.0, 105.0}}));
+        Path path;
+        path.setSections({pathSec});
+        sec.setPath(path);
+        QCOMPARE(sec.ascent(), 10);
+        QCOMPARE(sec.descent(), 5);
+        auto obj = JourneySection::toJson(sec);
+        QVERIFY(!obj.contains(s("ascent")));
+        QVERIFY(!obj.contains(s("descent")));
+
+        // explicitly set
+        sec.setAscent(12);
+        sec.setDescent(4);
+        QCOMPARE(sec.ascent(), 12);
+        QCOMPARE(sec.descent(), 4);
+        obj = JourneySection::toJson(sec);
+        QCOMPARE(obj.value(s("ascent")).toInt(), 12);
+        QCOMPARE(obj.value(s("descent")).toInt(), 4);
+        const auto sec2 = JourneySection::fromJson(obj);
+        QCOMPARE(sec2.ascent(), 12);
+        QCOMPARE(sec2.descent(), 4);
+        QCOMPARE(sec2.path().elevationProfile(), sec.path().elevationProfile());
+
+        // journey totals
+        JourneySection ptSec;
+        ptSec.setMode(JourneySection::PublicTransport);
+        Journey jny;
+        jny.setSections({ptSec});
+        QCOMPARE(jny.ascent(), -1);
+        QCOMPARE(jny.descent(), -1);
+        QVERIFY(!jny.hasCompleteElevation());
+        jny.setSections({sec, ptSec, sec});
+        QCOMPARE(jny.ascent(), 24);
+        QCOMPARE(jny.descent(), 8);
+        QVERIFY(jny.hasCompleteElevation());
+
+        // partial information
+        JourneySection walkSec;
+        walkSec.setMode(JourneySection::Walking);
+        jny.setSections({walkSec, ptSec, sec});
+        QCOMPARE(jny.ascent(), 12);
+        QCOMPARE(jny.descent(), 4);
+        QVERIFY(!jny.hasCompleteElevation());
+        jny.setSections({ptSec});
+        QVERIFY(!jny.hasCompleteElevation());
+    }
+
+    void testElevationMerge()
+    {
+        JourneySection lhs;
+        lhs.setMode(JourneySection::Walking);
+        auto rhs = lhs;
+
+        // ascent and descent are taken as a pair from one side
+        lhs.setAscent(100);
+        lhs.setDescent(10);
+        rhs.setAscent(50);
+        rhs.setDescent(80);
+        auto res = JourneySection::merge(lhs, rhs);
+        QCOMPARE(res.ascent(), 100);
+        QCOMPARE(res.descent(), 10);
+        res = JourneySection::merge(rhs, lhs);
+        QCOMPARE(res.ascent(), 50);
+        QCOMPARE(res.descent(), 80);
+
+        // explicit values are retained if only available on one side
+        rhs = {};
+        rhs.setMode(JourneySection::Walking);
+        res = JourneySection::merge(lhs, rhs);
+        QCOMPARE(res.ascent(), 100);
+        QCOMPARE(res.descent(), 10);
+        res = JourneySection::merge(rhs, lhs);
+        QCOMPARE(res.ascent(), 100);
+        QCOMPARE(res.descent(), 10);
+
+        // on equal level of detail, prefer the path with an elevation profile
+        PathSection plainSec;
+        plainSec.setPath(QPolygonF({{8.0, 49.0}, {8.0, 49.001}}));
+        Path plainPath;
+        plainPath.setSections({plainSec});
+        auto profileSec = plainSec;
+        profileSec.setElevationProfile(QPolygonF({{0.0, 100.0}, {111.0, 120.0}}));
+        Path profilePath;
+        profilePath.setSections({profileSec});
+
+        lhs = {};
+        lhs.setMode(JourneySection::Walking);
+        rhs = lhs;
+        lhs.setPath(plainPath);
+        rhs.setPath(profilePath);
+        res = JourneySection::merge(lhs, rhs);
+        QVERIFY(res.path().hasElevationProfile());
+        QCOMPARE(res.ascent(), 20);
+        QCOMPARE(res.descent(), 0);
+        res = JourneySection::merge(rhs, lhs);
+        QVERIFY(res.path().hasElevationProfile());
+
+        // the elevation profile wins over a more detailed path without one
+        // (e.g. MOTIS with many steps and per-step totals vs. OTP with fewer steps and a profile)
+        auto detailedSec = plainSec;
+        detailedSec.setAscent(300);
+        detailedSec.setDescent(30);
+        Path detailedPath;
+        detailedPath.setSections({detailedSec, plainSec, plainSec});
+        lhs.setPath(detailedPath);
+        lhs.setAscent(335);
+        lhs.setDescent(27);
+        QCOMPARE(lhs.path().ascent(), 300);
+        res = JourneySection::merge(lhs, rhs);
+        QCOMPARE(res.path().sections().size(), 1);
+        QVERIFY(res.path().hasElevationProfile());
+        QCOMPARE(res.ascent(), 20);
+        QCOMPARE(res.descent(), 0);
+        res = JourneySection::merge(rhs, lhs);
+        QCOMPARE(res.path().sections().size(), 1);
+        QVERIFY(res.path().hasElevationProfile());
+        QCOMPARE(res.ascent(), 20);
+        QCOMPARE(res.descent(), 0);
+
+        // without profiles the more detailed path wins, together with its elevation information
+        rhs.setPath(plainPath);
+        rhs.setAscent(5);
+        rhs.setDescent(50);
+        res = JourneySection::merge(lhs, rhs);
+        QCOMPARE(res.path().sections().size(), 3);
+        QCOMPARE(res.ascent(), 335);
+        QCOMPARE(res.descent(), 27);
+        res = JourneySection::merge(rhs, lhs);
+        QCOMPARE(res.path().sections().size(), 3);
+        QCOMPARE(res.ascent(), 335);
+        QCOMPARE(res.descent(), 27);
+
+        // the more detailed path wins, elevation information of the other side are used if it has none
+        Path detailedPlainPath;
+        detailedPlainPath.setSections({plainSec, plainSec, plainSec});
+        lhs.setPath(detailedPlainPath);
+        lhs.setAscent(-1);
+        lhs.setDescent(-1);
+        res = JourneySection::merge(lhs, rhs);
+        QCOMPARE(res.path().sections().size(), 3);
+        QCOMPARE(res.ascent(), 5);
+        QCOMPARE(res.descent(), 50);
+        res = JourneySection::merge(rhs, lhs);
+        QCOMPARE(res.path().sections().size(), 3);
+        QCOMPARE(res.ascent(), 5);
+        QCOMPARE(res.descent(), 50);
+    }
+
+    void testElevationSubsection()
+    {
+        const auto makeStop = [](double lat, double lon) {
+            Location loc;
+            loc.setCoordinate(lat, lon);
+            Stopover stop;
+            stop.setStopPoint(loc);
+            return stop;
+        };
+        const auto dep = makeStop(49.0, 8.0);
+        const auto stop = makeStop(49.001, 8.0);
+        const auto arr = makeStop(49.002, 8.0);
+
+        PathSection pathSec;
+        pathSec.setPath(QPolygonF({{8.0, 49.0}, {8.0, 49.001}, {8.0, 49.002}}));
+        pathSec.setElevationProfile(QPolygonF({{0.0, 100.0}, {222.0, 120.0}}));
+        Path path;
+        path.setSections({pathSec});
+
+        JourneySection sec;
+        sec.setMode(JourneySection::PublicTransport);
+        sec.setDeparture(dep);
+        sec.setIntermediateStops({stop});
+        sec.setArrival(arr);
+        sec.setPath(path);
+        sec.setAscent(25);
+        sec.setDescent(2);
+
+        // the full section retains everything
+        auto sub = sec.subsection(0, 2);
+        QCOMPARE(sub.ascent(), 25);
+        QCOMPARE(sub.descent(), 2);
+        QVERIFY(sub.path().hasElevationProfile());
+
+        // a part of it doesn't
+        sub = sec.subsection(0, 1);
+        QCOMPARE(sub.path().sections().size(), 1);
+        QCOMPARE(sub.path().sections()[0].path().size(), 2);
+        QCOMPARE(sub.ascent(), -1);
+        QCOMPARE(sub.descent(), -1);
+        QVERIFY(!sub.path().hasElevationProfile());
+    }
+
+    void testMergeBookingUrl()
+    {
+        const auto dt = QDateTime({2026, 11, 20}, {8, 0}, QTimeZone::UTC);
+
+        // derived booking URL on lhs, explicitly set one on rhs
+        RentalVehicle vehicle;
+        vehicle.setWebBookingUrl(QUrl(s("https://bike.example.org/")));
+        JourneySection lhsSec;
+        lhsSec.setMode(JourneySection::RentedVehicle);
+        lhsSec.setScheduledDepartureTime(dt);
+        lhsSec.setScheduledArrivalTime(dt.addSecs(600));
+        lhsSec.setRentalVehicle(vehicle);
+        Journey lhs;
+        lhs.setSections({lhsSec});
+        QCOMPARE(lhs.bookingUrl(), QUrl(s("https://bike.example.org/")));
+
+        JourneySection rhsSec;
+        rhsSec.setMode(JourneySection::RentedVehicle);
+        rhsSec.setScheduledDepartureTime(dt);
+        rhsSec.setScheduledArrivalTime(dt.addSecs(600));
+        Journey rhs;
+        rhs.setSections({rhsSec});
+        rhs.setBookingUrl(QUrl(s("https://shop.example.org/journey")));
+
+        // derived values must not be persisted by merging
+        QCOMPARE(Journey::merge(lhs, rhs).bookingUrl(), QUrl(s("https://shop.example.org/journey")));
+        QCOMPARE(Journey::merge(rhs, lhs).bookingUrl(), QUrl(s("https://shop.example.org/journey")));
+        QVERIFY(!Journey::toJson(Journey::merge(lhs, lhs)).contains("bookingUrl"_L1));
+    }
+
+    void testApplyRequestLocations()
+    {
+        Location requestFrom;
+        requestFrom.setName(u"Current location"_s);
+        requestFrom.setCoordinate(50.7753, 6.0838);
+        Location requestTo;
+        requestTo.setName(u"Großkölnstraße 58, Aachen"_s);
+        requestTo.setCoordinate(50.7773, 6.0864);
+
+        // what a backend returns when routing between coordinates
+        Location start;
+        start.setName(u"START"_s);
+        start.setCoordinate(50.77531, 6.08381);
+        Location stop;
+        stop.setType(Location::Stop);
+        stop.setName(u"Elisenbrunnen"_s);
+        stop.setCoordinate(50.7754, 6.0840);
+        Location end;
+        end.setCoordinate(50.7773, 6.0864);
+
+        JourneySection walk;
+        walk.setMode(JourneySection::Walking);
+        walk.setFrom(start);
+        walk.setTo(stop);
+        JourneySection walk2;
+        walk2.setMode(JourneySection::Walking);
+        walk2.setFrom(stop);
+        walk2.setTo(end);
+        Journey jny;
+        jny.setSections({walk, walk2});
+
+        JourneyUtil::applyRequestLocations(jny, requestFrom, requestTo);
+        QCOMPARE(jny.sections().front().from().name(), u"Current location"_s);
+        QCOMPARE(jny.sections().front().to().name(), u"Elisenbrunnen"_s);
+        QCOMPARE(jny.sections().back().to().name(), u"Großkölnstraße 58, Aachen"_s);
+        QCOMPARE(jny.sections().back().to().latitude(), 50.7773);
+
+        // stops are kept, as are places elsewhere
+        JourneySection ride;
+        ride.setMode(JourneySection::PublicTransport);
+        ride.setFrom(stop);
+        Location elsewhere;
+        elsewhere.setName(u"END"_s);
+        elsewhere.setCoordinate(50.80, 6.10);
+        ride.setTo(elsewhere);
+        jny.setSections({ride});
+        requestFrom.setCoordinate(50.7754, 6.0840);
+        JourneyUtil::applyRequestLocations(jny, requestFrom, requestTo);
+        QCOMPARE(jny.sections().front().from().name(), u"Elisenbrunnen"_s);
+        QCOMPARE(jny.sections().back().to().name(), u"END"_s);
+    }
 };
 
 QTEST_GUILESS_MAIN(JourneyTest)
