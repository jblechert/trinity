+/** Template token types. */
+enum class TokenType : uint8_t {
+    Literal,
+    FromName,
+    ToName,
+    FromId,
+    ToId,
+    FromCountry,
+    ToCountry,
+    Departure,
+    Arrival,
+    DepartureMinutesOfDay,
+    Language,
+};
+
+enum class Filter : uint8_t {
+    Capture,
+    Json,
+    Slug,
+    Lower,
+    Plus,
+};
+
+struct Token {
+    TokenType type = TokenType::Literal;
+    QString text; // literal content or date/time format
+    std::vector<Filter> filters;
+};
+
+struct OperatorRule {
+    std::vector<QRegularExpression> names;
+    QStringList hosts;
+    bool matchUnknown = false;
+
+    [[nodiscard]] bool isEmpty() const
+    {
+        return names.empty() && hosts.empty();
+    }
+    [[nodiscard]] bool matches(const Line &line) const;
+};
+
+struct StationIdentifierRule {
+    QString type;
+    QRegularExpression pattern;
+    std::vector<uint8_t> uicCountries; // sorted
+    QHash<QString, QString> aliases;
+};
+
+struct LanguageRule {
+    QString code;
+    QString value;
+    QChar::Script script = QChar::Script_Unknown;
+};
+
+struct ScriptName {
+    const char *name;
+    QChar::Script script;
+};
+constexpr inline const ScriptName script_names[] = {
+    {"Arabic", QChar::Script_Arabic},
+    {"Armenian", QChar::Script_Armenian},
+    {"Cyrillic", QChar::Script_Cyrillic},
+    {"Georgian", QChar::Script_Georgian},
+    {"Greek", QChar::Script_Greek},
+    {"Hebrew", QChar::Script_Hebrew},
+};
+
+}
+
+class KPublicTransport::TicketShopPrivate : public QSharedData
+{
+public:
+    [[nodiscard]] TicketShop::Match matchLine(const JourneySection &section) const;
+    /** Station identifier of @p loc for this shop.
+     *  @param capture return the first capturing group of the matching rule's pattern rather
+     *  than the entire identifier.
+     */
+    [[nodiscard]] QString stationIdentifier(const Location &loc, bool capture) const;
+    [[nodiscard]] QString language(const Location &from) const;
+
+    QString id;
+    QStringList countries;
+    QStringList requireCountries;
+    QStringList departureCountries;
+    std::vector<Line::Mode> lineModes;
+    std::optional<OperatorRule> operators;
+    OperatorRule excludeOperators;
+    std::vector<StationIdentifierRule> stationIdentifiers;
+    std::vector<LanguageRule> languages;
+    std::vector<Token> tokens;
+    QHash<QString, QString> nameAliases;
+};
+
+[[nodiscard]] static QString normalizeHost(const QString &host)
+{
+    auto h = host.toLower();
+    if (h.startsWith("www."_L1)) {
+        h = h.mid(4);
+    }
+    return h;
+}
+
+bool OperatorRule::matches(const Line &line) const
+{
+    if (const auto name = line.operatorName(); !name.isEmpty()) {
+        if (std::ranges::any_of(names, [&name](const auto &re) { return re.match(name).hasMatch(); })) {
+            return true;
+        }
+    }
+    if (const auto host = normalizeHost(line.operatorUrl().host()); !host.isEmpty()) {
+        if (std::ranges::any_of(hosts, [&host](const auto &h) { return host == h || (host.endsWith(h) && host.at(host.size() - h.size() - 1) == '.'_L1); })) {
+            return true;
+        }
+    }
+    return false;
+}
+
+TicketShop::Match TicketShopPrivate::matchLine(const JourneySection &section) const
+{
+    if (section.mode() != JourneySection::PublicTransport || section.disruptionEffect() == Disruption::NoService) {
+        return TicketShop::NoMatch;
+    }
+
+    const auto line = section.route().line();
+    if (std::ranges::find(lineModes, line.mode()) == lineModes.end()) {
+        return TicketShop::NoMatch;
+    }
+
+    if (excludeOperators.matches(line)) {
+        return TicketShop::NoMatch;
+    }
+    if (!operators) {
+        return TicketShop::GenericMatch;
+    }
+    if (operators->matches(line)) {
+        return TicketShop::OperatorMatch;
+    }
+    // only the name identifies the operator, as backends fill in their own operator URL
+    // for lines without one (see JourneyUtil::applyOperatorUrl)
+    if (!line.operatorName().isEmpty()) {
+        return TicketShop::NoMatch;
+    }
+    return operators->matchUnknown ? TicketShop::GenericMatch : TicketShop::NoMatch;
+}
+
+QString TicketShopPrivate::stationIdentifier(const Location &loc, bool capture) const
+{
+    for (const auto &rule : stationIdentifiers) {
+        auto id = loc.identifier(rule.type);
+        if (id.isEmpty()) {
+            continue;
+        }
+        if (const auto it = rule.aliases.constFind(id); it != rule.aliases.constEnd()) {
+            id = it.value();
+        }
+        QRegularExpressionMatch match;
+        if (!rule.pattern.pattern().isEmpty()) {
+            match = rule.pattern.match(id);
+            if (!match.hasMatch()) {
+                continue;
+            }
+        }
+        if (!rule.uicCountries.empty() && !UicStationCode::isValid(id, rule.uicCountries)) {
+            continue;
+        }
+        if (capture) {
+            // validated at load time that the pattern has a capturing group
+            return match.captured(1);
+        }
+        return rule.uicCountries.empty() ? id : id.right(7);
+    }
+    return {};
+}
+
+QString TicketShopPrivate::language(const Location &from) const
+{
+    // a station name in a specific script selects the language using that script
+    const auto name = from.name();
+    for (const auto &lang : languages) {
+        if (lang.script != QChar::Script_Unknown && std::ranges::any_of(name, [&lang](QChar c) { return c.script() == lang.script; })) {
+            return lang.value;
+        }
+    }
+
+    // otherwise follow the UI language preferences
+    const auto uiLanguages = QLocale().uiLanguages();
+    for (const auto &uiLang : uiLanguages) {
+        const auto sep = uiLang.indexOf('-'_L1);
+        const auto primary = sep < 0 ? QStringView(uiLang) : QStringView(uiLang).left(sep);
+        for (const auto &lang : languages) {
+            if (lang.script == QChar::Script_Unknown && primary.compare(lang.code, Qt::CaseInsensitive) == 0) {
+                return lang.value;
+            }
+        }
+    }
+
+    // fall back to the first generic entry
+    const auto it = std::ranges::find_if(languages, [](const auto &lang) { return lang.script == QChar::Script_Unknown; });
+    return it != languages.end() ? (*it).value : QString();
+}
+
+/** Location::country(), falling back to the country of the location's UIC or IBNR station code.
+ *  Location::country() determines the country from the coordinate if necessary, which has
+ *  no result close to borders, where many international train journeys start or end.
+ */
+[[nodiscard]] static QString countryOf(const Location &loc)
+{
+    if (auto country = loc.country(); !country.isEmpty()) {
+        return country;
+    }
+    for (const auto &type : {UicStationCode::identifierType(), u"ibnr"_s}) {
+        if (auto country = UicStationCode::isoCountry(loc.identifier(type)); !country.isEmpty()) {
+            return country;
+        }
+    }
+    return {};
+}
+
+TicketShop::TicketShop() = default;
+TicketShop::TicketShop(const TicketShop &) = default;
+TicketShop::TicketShop(TicketShop &&) noexcept = default;
+TicketShop::~TicketShop() = default;
+TicketShop &TicketShop::operator=(const TicketShop &) = default;
+TicketShop &TicketShop::operator=(TicketShop &&) noexcept = default;
+
+bool TicketShop::isValid() const
+{
+    return d;
+}
+
+QString TicketShop::id() const
+{
+    return d ? d->id : QString();
+}
+
+TicketShop::Match TicketShop::matchSection(const JourneySection &section) const
+{
+    if (!d) {
+        return NoMatch;
+    }
+
+    const auto m = d->matchLine(section);
+    if (m == NoMatch) {
+        return NoMatch;
+    }
+
+    const auto fromCountry = countryOf(section.from());
+    const auto toCountry = countryOf(section.to());
+    if (fromCountry.isEmpty() || toCountry.isEmpty() || !d->countries.contains(fromCountry) || !d->countries.contains(toCountry)) {
+        return NoMatch;
+    }
+    return m;
+}
+
+bool TicketShop::matchEndpoints(const Location &from, const Location &to) const
+{
+    if (!d) {
+        return false;
+    }
+    const auto fromCountry = countryOf(from);
+    if (!d->departureCountries.isEmpty() && !d->departureCountries.contains(fromCountry)) {
+        return false;
+    }
+    if (d->requireCountries.isEmpty()) {
+        return true;
+    }
+    const auto toCountry = countryOf(to);
+    return (!fromCountry.isEmpty() && d->requireCountries.contains(fromCountry)) || (!toCountry.isEmpty() && d->requireCountries.contains(toCountry));
+}
+
+/** Scheduled time as local wall-clock time at @p loc. */
+[[nodiscard]] static QDateTime localTime(const QDateTime &dt, const Location &loc)
+{
+    if (!dt.isValid() || dt.timeSpec() == Qt::LocalTime) { // floating time, use as-is
+        return dt;
+    }
+    if (const auto tz = loc.timeZone(); tz.isValid()) {
+        return dt.toTimeZone(tz);
+    }
+    return dt;
+}
+
+[[nodiscard]] static QString jsonEscape(const QString &s)
+{
+    QString res;
+    res.reserve(s.size());
+    for (const auto c : s) {
+        if (c == '"'_L1 || c == '\\'_L1) {
+            res += '\\'_L1;
+            res += c;
+        } else if (c.unicode() < 0x20) {
+            res += "\\u"_L1 + QString::number(c.unicode(), 16).rightJustified(4, '0'_L1);
+        } else {
+            res += c;
+        }
+    }
+    return res;
+}
+
+[[nodiscard]] static QString slugify(const QString &s)
+{
+    auto res = s.normalized(QString::NormalizationForm_D);
+    res.removeIf([](QChar c) { return c.category() == QChar::Mark_NonSpacing; });
+    static const QRegularExpression whitespace(u"\\s+"_s, QRegularExpression::UseUnicodePropertiesOption);
+    res.replace(whitespace, u"-"_s);
+    return res;
+}
+
+[[nodiscard]] static QString encodeValue(QString value, const std::vector<Filter> &filters)
+{
+    bool plus = false;
+    for (const auto filter : filters) {
+        switch (filter) {
+            case Filter::Capture: // already applied when determining the value
+                break;
+            case Filter::Json:
+                value = jsonEscape(value);
+                break;
+            case Filter::Slug:
+                value = slugify(value);
+                break;
+            case Filter::Lower:
+                value = value.toLower();
+                break;
+            case Filter::Plus:
+                plus = true;
+                break;
+        }
+    }
+
+    auto encoded = QUrl::toPercentEncoding(value);
+    if (plus) {
+        encoded.replace("%20", "+");
+    }
+    return QString::fromLatin1(encoded);
+}
+
+QUrl TicketShop::bookingUrl(const Location &from, const Location &to, const QDateTime &departure, const QDateTime &arrival) const
+{
+    if (!d) {
+        return {};
+    }
+
+    QString url;
+    for (const auto &token : d->tokens) {
+        QString value;
+        switch (token.type) {
+            case TokenType::Literal:
+                url += token.text;
+                continue;
+            case TokenType::FromName:
+            case TokenType::ToName:
+                value = (token.type == TokenType::FromName ? from : to).name().trimmed();
+                value = d->nameAliases.value(value, value);
+                break;
+            case TokenType::FromId:
+            case TokenType::ToId:
+                value = d->stationIdentifier(token.type == TokenType::FromId ? from : to, !token.filters.empty() && token.filters.front() == Filter::Capture);
+                break;
+            case TokenType::FromCountry:
+            case TokenType::ToCountry:
+                value = countryOf(token.type == TokenType::FromCountry ? from : to);
+                break;
+            case TokenType::Departure:
+            case TokenType::Arrival:
+            {
+                const auto dt = token.type == TokenType::Departure ? localTime(departure, from) : localTime(arrival, to);
+                if (!dt.isValid()) {
+                    return {};
+                }
+                url += QLocale::c().toString(dt, token.text);
+                continue;
+            }
+            case TokenType::DepartureMinutesOfDay:
+            {
+                const auto dt = localTime(departure, from);
+                if (!dt.isValid()) {
+                    return {};
+                }
+                url += QString::number(dt.time().hour() * 60 + dt.time().minute());
+                continue;
+            }
+            case TokenType::Language:
+                value = d->language(from);
+                if (value.isEmpty()) {
+                    return {};
+                }
+                url += value;
+                continue;
+        }
+
+        if (value.isEmpty()) {
+            return {};
+        }
+        url += encodeValue(value, token.filters);
+    }
+
+    QUrl res(url, QUrl::StrictMode);
+    if (!res.isValid()) {
+        qCWarning(Log) << "Generated invalid ticket shop URL" << d->id << url << res.errorString();
+        return {};
+    }
+    return res;
+}
+
+[[nodiscard]] static bool isStationToken(TokenType type)
+{
+    switch (type) {
+        case TokenType::FromName:
+        case TokenType::ToName:
+        case TokenType::FromId:
+        case TokenType::ToId:
+        case TokenType::FromCountry:
+        case TokenType::ToCountry:
+            return true;
+        default:
+            return false;
+    }
+}
+
+/** Parse a placeholder content, ie. the part between the curly brackets. */
+[[nodiscard]] static std::optional<Token> parsePlaceholder(QStringView placeholder)
+{
+    static constexpr const struct {
+        const char *name;
+        TokenType type;
+    } placeholder_names[] = {
+        {"from.name", TokenType::FromName},
+        {"to.name", TokenType::ToName},
+        {"from.id", TokenType::FromId},
+        {"to.id", TokenType::ToId},
+        {"from.country", TokenType::FromCountry},
+        {"to.country", TokenType::ToCountry},
+        {"departure", TokenType::Departure},
+        {"arrival", TokenType::Arrival},
+        {"departure.minutesOfDay", TokenType::DepartureMinutesOfDay},
+        {"lang", TokenType::Language},
+    };
+    static constexpr const struct {
+        const char *name;
+        Filter filter;
+    } filter_names[] = {
+        {"capture", Filter::Capture},
+        {"json", Filter::Json},
+        {"slug", Filter::Slug},
+        {"lower", Filter::Lower},
+        {"plus", Filter::Plus},
+    };
+
+    const auto parts = placeholder.split('|'_L1);
+    auto name = parts.at(0);
+    std::optional<QStringView> format;
+    if (const auto idx = name.indexOf(':'_L1); idx >= 0) {
+        format = name.mid(idx + 1);
+        name = name.left(idx);
+    }
+
+    Token token;
+    const auto it = std::ranges::find_if(placeholder_names, [name](const auto &p) { return name == QLatin1StringView(p.name); });
+    if (it == std::end(placeholder_names)) {
+        qCWarning(Log) << "unknown placeholder" << name;
+        return {};
+    }
+    token.type = (*it).type;
+
+    const auto needsFormat = token.type == TokenType::Departure || token.type == TokenType::Arrival;
+    if (needsFormat != format.has_value() || (format && format->isEmpty())) {
+        qCWarning(Log) << "invalid date/time format for placeholder" << placeholder;
+        return {};
+    }
+    if (format) {
+        token.text = format->toString();
+    }
+
+    for (auto filterIt = std::next(parts.begin()); filterIt != parts.end(); ++filterIt) {
+        const auto filter = std::ranges::find_if(filter_names, [&filterIt](const auto &f) { return (*filterIt) == QLatin1StringView(f.name); });
+        if (filter == std::end(filter_names)) {
+            qCWarning(Log) << "unknown filter" << (*filterIt);
+            return {};
+        }
+        if (!isStationToken(token.type)) {
+            qCWarning(Log) << "filters are only supported for station placeholders" << placeholder;
+            return {};
+        }
+        if ((*filter).filter == Filter::Capture
+            && ((token.type != TokenType::FromId && token.type != TokenType::ToId) || !token.filters.empty())) {
+            qCWarning(Log) << "capture filter is only supported as first filter of station identifier placeholders" << placeholder;
+            return {};
+        }
+        token.filters.push_back((*filter).filter);
+    }
+
+    return token;
+}
+
+[[nodiscard]] static bool parseTemplate(QStringView tpl, std::vector<Token> &tokens)
+{
+    QString literal;
+    for (qsizetype i = 0; i < tpl.size(); ++i) {
+        if (tpl[i] == '}'_L1) {
+            qCWarning(Log) << "unbalanced '}' in URL template" << tpl;
+            return false;
+        }
+        if (tpl[i] != '{'_L1) {
+            literal += tpl[i];
+            continue;
+        }
+
+        const auto end = tpl.indexOf('}'_L1, i);
+        const auto next = tpl.indexOf('{'_L1, i + 1);
+        if (end < 0 || (next >= 0 && next < end)) {
+            qCWarning(Log) << "unbalanced '{' in URL template" << tpl;
+            return false;
+        }
+        if (!literal.isEmpty()) {
+            tokens.push_back({.type = TokenType::Literal, .text = literal, .filters = {}});
+            literal.clear();
+        }
+        auto token = parsePlaceholder(tpl.mid(i + 1, end - i - 1));
+        if (!token) {
+            return false;
+        }
+        tokens.push_back(std::move(*token));
+        i = end;
+    }
+
+    if (!literal.isEmpty()) {
+        tokens.push_back({.type = TokenType::Literal, .text = literal, .filters = {}});
+    }
+    return true;
+}
+
+[[nodiscard]] static bool parseCountries(const QJsonValue &val, QStringList &countries)
+{
+    static const QRegularExpression countryCodeRx(u"^[A-Z]{2}$"_s);
+    const auto a = val.toArray();
+    for (const auto &v : a) {
+        const auto c = v.toString();
+        if (!countryCodeRx.match(c).hasMatch()) {
+            qCWarning(Log) << "invalid country code" << v;
+            return false;
+        }
+        countries.push_back(c);
+    }
+    return true;
+}
+
+[[nodiscard]] static bool parseRegularExpression(const QString &pattern, QRegularExpression::PatternOptions options, QRegularExpression &re)
+{
+    re = QRegularExpression(pattern, options);
+    if (!re.isValid()) {
+        qCWarning(Log) << "invalid regular expression" << pattern << re.errorString();
+        return false;
+    }
+    re.optimize();
+    return true;
+}
+
+[[nodiscard]] static bool parseOperatorRule(const QJsonObject &obj, OperatorRule &rule)
+{
+    const auto names = obj.value("names"_L1).toArray();
+    for (const auto &name : names) {
+        QRegularExpression re;
+        if (!parseRegularExpression(name.toString(), QRegularExpression::CaseInsensitiveOption | QRegularExpression::UseUnicodePropertiesOption, re)) {
+            return false;
+        }
+        rule.names.push_back(std::move(re));
+    }
+    const auto hosts = obj.value("hosts"_L1).toArray();
+    for (const auto &host : hosts) {
+        const auto h = normalizeHost(host.toString());
+        if (h.isEmpty()) {
+            qCWarning(Log) << "invalid operator host" << host;
+            return false;
+        }
+        rule.hosts.push_back(h);
+    }
+    rule.matchUnknown = obj.value("matchUnknown"_L1).toBool(false);
+    return true;
+}
+
+[[nodiscard]] static bool parseMatch(const QJsonObject &obj, TicketShopPrivate *d)
+{
+    if (!parseCountries(obj.value("countries"_L1), d->countries) || d->countries.isEmpty()) {
+        qCWarning(Log) << "missing or invalid countries";
+        return false;
+    }
+    if (!parseCountries(obj.value("requireCountries"_L1), d->requireCountries)) {
+        return false;
+    }
+    if (!parseCountries(obj.value("departureCountries"_L1), d->departureCountries)) {
+        return false;
+    }
+
+    if (const auto modes = obj.value("lineModes"_L1); modes.isArray()) {
+        const auto me = QMetaEnum::fromType<Line::Mode>();
+        const auto a = modes.toArray();
+        for (const auto &mode : a) {
+            bool ok = false;
+            const auto value = me.keyToValue(mode.toString().toUtf8().constData(), &ok);
+            if (!ok) {
+                qCWarning(Log) << "unknown line mode" << mode;
+                return false;
+            }
+            d->lineModes.push_back(static_cast<Line::Mode>(value));
+        }
+    } else {
+        d->lineModes = {Line::LongDistanceTrain, Line::Train, Line::LocalTrain};
+    }
+
+    if (const auto ops = obj.value("operators"_L1).toObject(); !ops.isEmpty()) {
+        OperatorRule rule;
+        if (!parseOperatorRule(ops, rule)) {
+            return false;
+        }
+        if (!rule.isEmpty()) {
+            d->operators = std::move(rule);
+        }
+    }
+    return parseOperatorRule(obj.value("excludeOperators"_L1).toObject(), d->excludeOperators);
+}
+
+[[nodiscard]] static bool parseAliases(const QJsonObject &obj, QHash<QString, QString> &aliases)
+{
+    for (auto it = obj.begin(); it != obj.end(); ++it) {
+        const auto alias = it.value().toString();
+        if (it.key().isEmpty() || alias.isEmpty()) {
+            qCWarning(Log) << "invalid alias" << it.key() << it.value();
+            return false;
+        }
+        aliases.insert(it.key(), alias);
+    }
+    return true;
+}
+
+[[nodiscard]] static bool parseStationIdentifiers(const QJsonArray &a, TicketShopPrivate *d)
+{
+    for (const auto &v : a) {
+        const auto obj = v.toObject();
+        StationIdentifierRule rule;
+        rule.type = obj.value("type"_L1).toString();
+        if (rule.type.isEmpty()) {
+            qCWarning(Log) << "station identifier rule without type";
+            return false;
+        }
+        if (const auto pattern = obj.value("pattern"_L1).toString(); !pattern.isEmpty() && !parseRegularExpression(pattern, {}, rule.pattern)) {
+            return false;
+        }
+        const auto uicCountries = obj.value("uicCountries"_L1).toArray();
+        for (const auto &c : uicCountries) {
+            const auto code = c.toInt(-1);
+            if (code < 10 || code > 99) {
+                qCWarning(Log) << "invalid UIC country code" << c;
+                return false;
+            }
+            rule.uicCountries.push_back(static_cast<uint8_t>(code));
+        }
+        std::ranges::sort(rule.uicCountries);
+        if (!parseAliases(obj.value("aliases"_L1).toObject(), rule.aliases)) {
+            return false;
+        }
+        d->stationIdentifiers.push_back(std::move(rule));
+    }
+    return true;
+}
+
+[[nodiscard]] static bool parseLanguages(const QJsonArray &a, TicketShopPrivate *d)
+{
+    for (const auto &v : a) {
+        const auto obj = v.toObject();
+        LanguageRule rule;
+        rule.code = obj.value("code"_L1).toString();
+        if (rule.code.isEmpty()) {
+            qCWarning(Log) << "language rule without code";
+            return false;
+        }
+        rule.value = obj.value("value"_L1).toString(rule.code);
+        if (const auto script = obj.value("script"_L1).toString(); !script.isEmpty()) {
+            const auto it = std::ranges::find_if(script_names, [&script](const auto &s) { return script == QLatin1StringView(s.name); });
+            if (it == std::end(script_names)) {
+                qCWarning(Log) << "unknown script" << script;
+                return false;
+            }
+            rule.script = (*it).script;
+        }
+        d->languages.push_back(std::move(rule));
+    }
+    return true;
+}
+
+/** Checks that the template produces a syntactically valid https URL. */
+[[nodiscard]] static bool validateTemplate(const TicketShopPrivate *d)
+{
+    QString url;
+    bool needsLanguage = false;
+    bool needsStationId = false;
+    bool needsCapture = false;
+    for (const auto &token : d->tokens) {
+        url += token.type == TokenType::Literal ? token.text : u"x"_s;
+        needsLanguage |= token.type == TokenType::Language;
+        needsStationId |= token.type == TokenType::FromId || token.type == TokenType::ToId;
+        needsCapture |= std::ranges::find(token.filters, Filter::Capture) != token.filters.end();
+    }
+
+    if (needsLanguage && d->languages.empty()) {
+        qCWarning(Log) << "URL template uses {lang} but there are no languages";
+        return false;
+    }
+    if (needsLanguage && std::ranges::none_of(d->languages, [](const auto &lang) { return lang.script == QChar::Script_Unknown; })) {
+        qCWarning(Log) << "URL template uses {lang} but there is no script-independent language";
+        return false;
+    }
+    if (needsStationId && d->stationIdentifiers.empty()) {
+        qCWarning(Log) << "URL template uses station identifiers but there are no station identifier rules";
+        return false;
+    }
+    if (needsCapture && std::ranges::any_of(d->stationIdentifiers, [](const auto &rule) { return rule.pattern.captureCount() < 1; })) {
+        qCWarning(Log) << "URL template uses the capture filter but not all station identifier rules have a pattern with a capturing group";
+        return false;
+    }
+
+    const QUrl u(url, QUrl::StrictMode);
+    if (!u.isValid() || u.scheme() != "https"_L1 || u.host().isEmpty()) {
+        qCWarning(Log) << "URL template does not produce a valid https URL" << url << u.errorString();
+        return false;
+    }
+    return true;
+}
+
+TicketShop TicketShop::fromJson(const QJsonObject &obj)
+{
+    QExplicitlySharedDataPointer<TicketShopPrivate> d(new TicketShopPrivate);
+    d->id = obj.value("id"_L1).toString();
+    static const QRegularExpression idRx(u"^[a-z]{2}_[a-z0-9]+$"_s);
+    if (!idRx.match(d->id).hasMatch() || obj.value("name"_L1).toString().isEmpty()) {
+        qCWarning(Log) << "Ticket shop without valid id or name:" << d->id;
+        return {};
+    }
+
+    const auto url = obj.value("url"_L1).toString();
+    if (!parseMatch(obj.value("match"_L1).toObject(), d.data())
+        || !parseStationIdentifiers(obj.value("stationIdentifiers"_L1).toArray(), d.data())
+        || !parseLanguages(obj.value("languages"_L1).toArray(), d.data())
+        || !parseAliases(obj.value("nameAliases"_L1).toObject(), d->nameAliases)
+        || !url.startsWith("https://"_L1)
+        || !parseTemplate(url, d->tokens)
+        || !validateTemplate(d.data())
+    ) {
+        qCWarning(Log) << "Discarding invalid ticket shop" << d->id;
+        return {};
+    }
+
+    TicketShop shop;
+    shop.d = std::move(d);
+    return shop;
+}
+
+std::vector<TicketShop> TicketShops::loadFromFile(const QString &fileName)
+{
+    QFile f(fileName);
+    if (!f.open(QFile::ReadOnly)) {
+        qCWarning(Log) << "Failed to open ticket shop table" << fileName << f.errorString();
+        return {};
+    }
+
+    QJsonParseError error;
+    const auto doc = QJsonDocument::fromJson(f.readAll(), &error);
+    if (error.error != QJsonParseError::NoError) {
+        qCWarning(Log) << "Failed to parse ticket shop table" << fileName << error.errorString() << error.offset;
+        return {};
+    }
+
+    const auto a = doc.object().value("shops"_L1).toArray();
+    std::vector<TicketShop> shops;
+    shops.reserve(a.size());
+    QSet<QString> ids;
+    for (const auto &v : a) {
+        // invalid entries are dropped, they could come in via online updates with features we don't support yet
+        auto shop = TicketShop::fromJson(v.toObject());
+        if (!shop.isValid()) {
+            continue;
+        }
+        if (ids.contains(shop.id())) {
+            qCWarning(Log) << "Duplicate ticket shop" << shop.id();
+            continue;
+        }
+        ids.insert(shop.id());
+        shops.push_back(std::move(shop));
+    }
+    return shops;
+}
+
+namespace {
+struct TicketShopTable {
+    QMutex mutex;
+    std::vector<TicketShop> shops;
+    bool loaded = false;
+};
+}
+
+[[nodiscard]] static TicketShopTable &shopTable()
+{
+    static TicketShopTable table;
+    return table;
+}
+
+std::vector<TicketShop> TicketShops::shops()
+{
+    auto &table = shopTable();
+    const QMutexLocker locker(&table.mutex);
+    if (!table.loaded) {
+        table.shops = loadFromFile(StandardPaths::locateFile(u"networks/booking/ticket-shops.json"_s));
+        table.loaded = true;
+    }
+    return table.shops;
+}
+
+void TicketShops::reload()
+{
+    auto &table = shopTable();
+    const QMutexLocker locker(&table.mutex);
+    table.shops.clear();
+    table.loaded = false;
+}
+
+namespace {
+struct Candidate {
+    TicketShop::Match match;
+    const TicketShop *shop;
+};
+}
+
+[[nodiscard]] static QUrl expandFirst(std::vector<Candidate> &candidates, const Location &from, const Location &to, const QDateTime &departure, const QDateTime &arrival)
+{
+    // file order is the tie-breaker
+    std::ranges::stable_sort(candidates, std::greater{}, &Candidate::match);
+    for (const auto &c : candidates) {
+        // not all shops can expand all placeholders for every location, so fall through to the next one
+        if (auto url = c.shop->bookingUrl(from, to, departure, arrival); !url.isEmpty()) {
+            return url;
+        }
+    }
+    return {};
+}
+
+QUrl TicketShops::bookingUrl(const JourneySection &section)
+{
+    if (section.mode() != JourneySection::PublicTransport) {
+        return {};
+    }
+
+    const auto allShops = shops();
+    const auto from = section.from();
+    const auto to = section.to();
+    std::vector<Candidate> candidates;
+    for (const auto &shop : allShops) {
+        if (const auto m = shop.matchSection(section); m != TicketShop::NoMatch && shop.matchEndpoints(from, to)) {
+            candidates.push_back({.match = m, .shop = &shop});
+        }
+    }
+    return expandFirst(candidates, from, to, section.scheduledDepartureTime(), section.scheduledArrivalTime());
+}
+
+QUrl TicketShops::bookingUrl(const Journey &journey)
+{
+    std::vector<const JourneySection *> pt;
+    for (const auto &section : journey.sections()) {
+        if (section.mode() == JourneySection::PublicTransport) {
+            pt.push_back(&section);
+        }
+    }
+    if (pt.empty()) {
+        return {};
+    }
+
+    const auto allShops = shops();
+    const auto from = pt.front()->from();
+    const auto to = pt.back()->to();
+    std::vector<Candidate> candidates;
+    for (const auto &shop : allShops) {
+        auto match = TicketShop::OperatorMatch;
+        for (const auto section : pt) {
+            match = std::min(match, shop.matchSection(*section));
+            if (match == TicketShop::NoMatch) {
+                break;
+            }
+        }
+        if (match != TicketShop::NoMatch && shop.matchEndpoints(from, to)) {
+            candidates.push_back({.match = match, .shop = &shop});
+        }
+    }
+    return expandFirst(candidates, from, to, pt.front()->scheduledDepartureTime(), pt.back()->scheduledArrivalTime());
+}
