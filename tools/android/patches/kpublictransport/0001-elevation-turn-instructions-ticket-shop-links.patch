+    void testPrepareForNavigation()
+    {
+        // L-shapes
+        for (const auto &[turnAngle, expected] : { std::pair{-90.0, PathSection::Left}, std::pair{90.0, PathSection::Right}, std::pair{40.0, PathSection::SlightRight}, std::pair{-140.0, PathSection::SharpLeft} }) {
+            const auto first = line(Berlin, 10.0, 80.0);
+            Path path;
+            path.setSections({makeSection(first, u"A"_s), makeSection(line(first.back(), 10.0 + turnAngle, 80.0), u"B"_s)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.sections()[0].turnDirection(), PathSection::UnknownTurnDirection);
+            QCOMPARE(path.sections()[0].instruction(), "Head north on A"_L1);
+            QCOMPARE(path.sections()[1].turnDirection(), expected);
+        }
+
+        // straight chain on the same street merges into one section
+        {
+            auto p1 = line(Berlin, 90.0, 50.0);
+            auto p2 = line(p1.back(), 95.0, 50.0);
+            auto p3 = line(p2.back(), 85.0, 50.0);
+            Path path;
+            path.setSections({makeSection(p1, u"Hauptstraße"_s), makeSection(p2, u"Hauptstraße"_s), makeSection(p3, u"Hauptstraße"_s)});
+            const auto distance = path.distance();
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 1);
+            QCOMPARE(path.distance(), distance);
+            QCOMPARE(path.sections()[0].path().size(), 4);
+            QCOMPARE(path.sections()[0].instruction(), u"Head east on Hauptstraße"_s);
+        }
+
+        // slight bends: merged when following the same named street, kept otherwise
+        {
+            auto p1 = line(Berlin, 0.0, 50.0);
+            auto p2 = line(p1.back(), 40.0, 50.0);
+            Path path;
+            path.setSections({makeSection(p1, u"Hauptstraße"_s), makeSection(p2, u"Hauptstraße"_s)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 1);
+
+            path.setSections({makeSection(p1), makeSection(p2)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.sections()[1].instruction(), "Slight right"_L1);
+
+            // different street names are never merged
+            path.setSections({makeSection(p1, u"A"_s), makeSection(line(p1.back(), 0.0, 50.0), u"B"_s)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.sections()[1].instruction(), "Continue on B"_L1);
+        }
+
+        // short unnamed connectors are absorbed, and don't disturb the turn detection
+        {
+            auto p1 = line(Berlin, 0.0, 50.0);
+            auto p2 = line(p1.back(), 300.0, 3.0);
+            auto p3 = line(p2.back(), 90.0, 50.0);
+            Path path;
+            path.setSections({makeSection(p1, u"A"_s), makeSection(p2), makeSection(p3, u"B"_s)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.sections()[0].path().size(), 3);
+            QCOMPARE(path.sections()[1].turnDirection(), PathSection::Right);
+            QCOMPARE(path.sections()[1].instruction(), "Turn right onto B"_L1);
+        }
+
+        // a corner made up of several chained connectors
+        for (const auto &streetName : { u"B"_s, QString() }) {
+            for (int count = 1; count <= 6; ++count) {
+                const auto p1 = denseLine(Berlin, 0.0, 100.0);
+                std::vector<PathSection> sections({makeSection(p1, u"A"_s)});
+                auto p = p1.back();
+                for (int i = 0; i < count; ++i) {
+                    sections.push_back(makeSection(line(p, 90.0, 4.0)));
+                    p = sections.back().path().back();
+                }
+                sections.push_back(makeSection(denseLine(p, 90.0, 100.0), streetName));
+                Path path;
+                path.setSections(std::move(sections));
+                path.prepareForNavigation();
+                QCOMPARE(path.sections().size(), 2);
+                QCOMPARE(path.sections()[0].path().size(), p1.size() + count);
+                QCOMPARE(path.sections()[1].turnDirection(), PathSection::Right);
+                QCOMPARE(path.sections()[1].instruction(), streetName.isEmpty() ? "Turn right"_L1 : "Turn right onto B"_L1);
+            }
+        }
+
+        // short connectors not part of the turn, such as crossing a sidewalk
+        {
+            const auto p1 = denseLine(Berlin, 0.0, 100.0);
+            const auto p2 = line(p1.back(), 90.0, 3.0);
+            const auto p3 = line(p2.back(), 0.0, 2.0);
+            const auto p4 = denseLine(p3.back(), 0.0, 100.0);
+            Path path;
+            path.setSections({makeSection(p1, u"A"_s), makeSection(p2), makeSection(p3), makeSection(p4, u"B"_s)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.sections()[1].instruction(), "Continue on B"_L1);
+        }
+
+        // continuing straight onto an unnamed way doesn't need an instruction
+        {
+            const auto p1 = line(Berlin, 0.0, 50.0);
+            const auto p2 = line(p1.back(), 5.0, 50.0);
+            const auto p3 = line(p2.back(), 10.0, 50.0);
+            Path path;
+            path.setSections({makeSection(p1, u"A"_s), makeSection(p2), makeSection(p3, u"B"_s)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.sections()[0].instruction(), "Head north on A"_L1);
+            QCOMPARE(path.sections()[0].distance(), 100);
+            QCOMPARE(path.sections()[1].instruction(), "Continue on B"_L1);
+
+            // turning onto an unnamed way does
+            path.setSections({makeSection(p1, u"A"_s), makeSection(line(p1.back(), 90.0, 50.0))});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.sections()[1].instruction(), "Turn right"_L1);
+        }
+
+        // things blocking merging or overriding
+        {
+            auto p1 = line(Berlin, 0.0, 50.0);
+            auto p2 = line(p1.back(), 0.0, 50.0);
+            auto p3 = line(p2.back(), 0.0, 3.0);
+
+            auto stairs = makeSection(p2, u"A"_s);
+            stairs.setFloorLevelChange(1);
+            Path path;
+            path.setSections({makeSection(p1, u"A"_s), stairs, makeSection(p3)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 3);
+
+            auto described = makeSection(p2, u"A"_s);
+            described.setDescription(u"Follow the signs"_s);
+            path.setSections({makeSection(p1, u"A"_s), described, makeSection(p3)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 3);
+            QCOMPARE(path.sections()[1].turnDirection(), PathSection::Straight);
+            QCOMPARE(path.sections()[1].instruction(), "Follow the signs"_L1);
+
+            auto backendTurn = makeSection(p2, u"A"_s);
+            backendTurn.setTurnDirection(PathSection::Left);
+            path.setSections({makeSection(p1, u"A"_s), backendTurn});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            QCOMPARE(path.sections()[1].turnDirection(), PathSection::Left);
+
+            auto otherFloor = makeSection(p2, u"A"_s);
+            otherFloor.setStartFloorLevel(1);
+            auto firstSection = makeSection(p1, u"A"_s);
+            firstSection.setStartFloorLevel(0);
+            path.setSections({firstSection, otherFloor});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 2);
+            otherFloor.setStartFloorLevel(0);
+            path.setSections({firstSection, otherFloor});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 1);
+        }
+
+        // elevators: no turn after the elevator point
+        {
+            auto p1 = line(Berlin, 0.0, 50.0);
+            PathSection elevator;
+            elevator.setManeuver(PathSection::Elevator);
+            elevator.setFloorLevelChange(-2);
+            elevator.setPath(QPolygonF({p1.back()}));
+            auto p2 = line(p1.back(), 180.0, 50.0);
+            Path path;
+            path.setSections({makeSection(p1), elevator, makeSection(p2)});
+            path.prepareForNavigation();
+            QCOMPARE(path.sections().size(), 3);
+            QCOMPARE(path.sections()[0].turnDirection(), PathSection::UnknownTurnDirection);
+            QCOMPARE(path.sections()[1].turnDirection(), PathSection::UnknownTurnDirection);
+            QCOMPARE(path.sections()[2].turnDirection(), PathSection::UnknownTurnDirection);
+            QCOMPARE(path.sections()[1].instruction(), "Take the elevator down"_L1);
+            QCOMPARE(path.sections()[2].instruction(), "Head south"_L1);
+        }
+
+        // idempotence
+        {
+            auto p1 = line(Berlin, 0.0, 50.0);
+            auto p2 = line(p1.back(), 3.0, 30.0);
+            auto p3 = line(p2.back(), 80.0, 2.0);
+            auto p4 = line(p3.back(), 85.0, 40.0);
+            auto p5 = line(p4.back(), 120.0, 40.0);
+            auto p6 = line(p5.back(), 125.0, 4.0);
+            Path path;
+            path.setSections({makeSection(p1, u"A"_s), makeSection(p2, u"A"_s), makeSection(p3), makeSection(p4), makeSection(p5, u"B"_s), makeSection(p6)});
+            path.prepareForNavigation();
+            const auto once = Path::toJson(path);
+            path.prepareForNavigation();
+            QCOMPARE(Path::toJson(path), once);
+            QCOMPARE(path.sections().size(), 3);
+            QCOMPARE(path.sections()[1].instruction(), "Turn right"_L1);
+            QCOMPARE(path.sections()[2].instruction(), "Slight right onto B"_L1);
+        }
+    }
