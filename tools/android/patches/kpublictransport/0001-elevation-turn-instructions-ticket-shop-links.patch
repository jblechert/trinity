+    void testElevationJson()
+    {
+        PathSection sec;
+        sec.setPath(QPolygonF({{8.0, 49.0}, {8.0, 49.001}}));
+        auto obj = PathSection::toJson(sec);
+        QVERIFY(!obj.contains("ascent"_L1));
+        QVERIFY(!obj.contains("descent"_L1));
+        QVERIFY(!obj.contains("elevationProfile"_L1));
+
+        // computed values aren't serialized
+        sec.setElevationProfile(QPolygonF({{0.0, -2.5}, {50.25, 10.0}}));
+        obj = PathSection::toJson(sec);
+        QVERIFY(!obj.contains("ascent"_L1));
+        QVERIFY(!obj.contains("descent"_L1));
+        QCOMPARE(obj.value("elevationProfile"_L1), QJsonValue(QJsonArray({QJsonArray({0.0, -2.5}), QJsonArray({50.25, 10.0})})));
+
+        sec.setAscent(14);
+        sec.setDescent(0);
+        obj = PathSection::toJson(sec);
+        QCOMPARE(obj.value("ascent"_L1).toInt(), 14);
+        QCOMPARE(obj.value("descent"_L1).toInt(), 0);
+
+        const auto sec2 = PathSection::fromJson(QJsonDocument::fromJson(QJsonDocument(obj).toJson()).object());
+        QCOMPARE(sec2.ascent(), 14);
+        QCOMPARE(sec2.descent(), 0);
+        QCOMPARE(sec2.elevationProfile(), sec.elevationProfile());
+        QCOMPARE(sec2.path(), sec.path());
+
+        // data without elevation information
+        const auto sec3 = PathSection::fromJson(QJsonDocument::fromJson(R"({"description":"Foo"})").object());
+        QCOMPARE(sec3.ascent(), -1);
+        QCOMPARE(sec3.descent(), -1);
+        QVERIFY(!sec3.hasElevationProfile());
+    }
