+template <typename Getter>
+[[nodiscard]] static int sumElevationChanges(const std::vector<PathSection> &sections, Getter getter)
+{
+    int sum = -1;
+    for (const auto &section : sections) {
+        if (const auto value = getter(section); value >= 0) {
+            sum = std::max(sum, 0) + value;
+        }
+    }
+    return sum;
+}
+
+bool PathUtil::hasOnlyElevationProfiles(const std::vector<PathSection> &sections)
+{
+    bool hasProfile = false;
+    for (const auto &section : sections) {
+        // explicitly set values take precedence over the profile of a section
+        if (PathSectionPrivate::hasExplicitElevationChanges(section)) {
+            return false;
+        }
+        hasProfile |= section.hasElevationProfile();
+    }
+    return hasProfile;
+}
+
+/** Append the elevation profile of @p section to @p profile, shifted by @p offset.
+ *  @returns The length of @p section along the profile, ie. the offset of the subsequent section.
+ */
+static double appendElevationProfile(QPolygonF &profile, const PathSection &section, double offset)
+{
+    const auto dist = section.distance();
+    double sectionLength = dist;
+    for (auto p : section.elevationProfile()) {
+        // profiles can slightly overrun the geometry of their section
+        // clamp them to keep the overall profile monotonic
+        if (dist > 0) {
+            p.setX(std::clamp(p.x(), 0.0, (double)dist));
+        }
+        sectionLength = std::max(sectionLength, p.x());
+        p.setX(p.x() + offset);
+        if (profile.isEmpty() || profile.constLast() != p) {
+            profile.push_back(p);
+        }
+    }
+    return sectionLength;
+}
+
+void PathUtil::appendElevation(PathSection &to, const PathSection &from, bool profilesOnly)
+{
+    // sum of both values, ignoring unknown ones
+    constexpr auto sum = [](int lhs, int rhs) { return lhs < 0 ? rhs : rhs < 0 ? lhs : lhs + rhs; };
+    const auto ascent = sum(to.ascent(), from.ascent());
+    const auto descent = sum(to.descent(), from.descent());
+
+    if (to.hasElevationProfile() || from.hasElevationProfile()) {
+        QPolygonF profile;
+        const auto offset = appendElevationProfile(profile, to, 0.0);
+        appendElevationProfile(profile, from, offset);
+        to.setElevationProfile(profile);
+    }
+
+    // If the path's elevation changes are computed from the combined profile, the merged profile
+    // yields the same result. Otherwise the path sums up the per section values, so keep their sum
+    // explicitly, as the merged profile would include the elevation change between the merged
+    // sections that isn't part of either section on its own.
+    if (!profilesOnly) {
+        to.setAscent(ascent);
+        to.setDescent(descent);
+    }
+}
+
+int Path::ascent() const
+{
+    if (PathUtil::hasOnlyElevationProfiles(d->sections)) {
+        return ElevationUtil::ascent(elevationProfile());
+    }
+    return sumElevationChanges(d->sections, [](const PathSection &section) { return section.ascent(); });
+}
+
+int Path::descent() const
+{
+    if (PathUtil::hasOnlyElevationProfiles(d->sections)) {
+        return ElevationUtil::descent(elevationProfile());
+    }
+    return sumElevationChanges(d->sections, [](const PathSection &section) { return section.descent(); });
+}
+
+QPolygonF Path::elevationProfile() const
+{
+    QPolygonF profile;
+    double offset = 0.0;
+    for (const auto &section : d->sections) {
+        offset += appendElevationProfile(profile, section, offset);
+    }
+    return profile;
+}
+
+bool Path::hasElevationProfile() const
+{
+    return std::any_of(d->sections.begin(), d->sections.end(), [](const auto &section) { return section.hasElevationProfile(); });
+}
+
+void Path::prepareForNavigation()
+{
+    d.detach();
+    PathUtil::absorbShortConnectors(d->sections);
+    PathUtil::fillTurnDirections(d->sections);
+    PathUtil::mergeSections(d->sections);
+}
