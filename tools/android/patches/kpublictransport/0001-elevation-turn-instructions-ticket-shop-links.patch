+void JourneyUtil::prepareNavigationPath(JourneySection &section)
+{
+    if (section.mode() == JourneySection::PublicTransport || section.path().isEmpty()) {
+        return;
+    }
+
+    auto path = section.path();
+    path.prepareForNavigation();
+    section.setPath(path);
+}
+
+// how far a returned place may be from the requested position to be considered the same
+constexpr inline auto REQUEST_LOCATION_DISTANCE = 25.0; // meters
+
+static void applyRequestLocation(Location &loc, const Location &requested)
+{
+    // stops are what the backend knows better, and are found by name anyway
+    if (requested.name().isEmpty() || loc.type() == Location::Stop || !loc.hasCoordinate() || !requested.hasCoordinate()) {
+        return;
+    }
+    if (Location::distance(loc, requested) > REQUEST_LOCATION_DISTANCE) {
+        return;
+    }
+    loc.setName(requested.name());
+    if (loc.streetAddress().isEmpty() && loc.locality().isEmpty()) {
+        loc.setStreetAddress(requested.streetAddress());
+        loc.setPostalCode(requested.postalCode());
+        loc.setLocality(requested.locality());
+        loc.setRegion(requested.region());
+        loc.setCountry(requested.country());
+    }
+}
+
+void JourneyUtil::applyRequestLocations(Journey &jny, const Location &from, const Location &to)
+{
+    auto sections = jny.takeSections();
+    if (!sections.empty()) {
+        auto departure = sections.front().from();
+        applyRequestLocation(departure, from);
+        sections.front().setFrom(departure);
+        auto arrival = sections.back().to();
+        applyRequestLocation(arrival, to);
+        sections.back().setTo(arrival);
+    }
+    jny.setSections(std::move(sections));
+}
