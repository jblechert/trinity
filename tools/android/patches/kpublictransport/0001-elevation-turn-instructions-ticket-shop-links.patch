+        auto shop = makeShop(u"https://example.org/{from.id}/{to.id}"_s,
+                             {{"stationIdentifiers"_L1, QJsonArray{QJsonObject{{"type"_L1, "uic"_L1}, {"aliases"_L1, QJsonObject{{"8000001"_L1, "8000003"_L1}}}}}}});
+        QVERIFY(shop.isValid());
+        QCOMPARE(shop.bookingUrl(from, to, dep, dep).toString(QUrl::FullyEncoded), "https://example.org/8000003/8000002"_L1);
+
+        // aliases are applied before checking the pattern
+        shop = makeShop(u"https://example.org/{from.id}/{to.id}"_s,
+                        {{"stationIdentifiers"_L1, QJsonArray{QJsonObject{{"type"_L1, "uic"_L1}, {"pattern"_L1, "^8000003$|^8000002$"_L1}, {"aliases"_L1, QJsonObject{{"8000001"_L1, "8000003"_L1}}}}}}});
+        QCOMPARE(shop.bookingUrl(from, to, dep, dep).toString(QUrl::FullyEncoded), "https://example.org/8000003/8000002"_L1);
+
+        // station names
+        shop = makeShop(u"https://example.org/{from.name}/{to.name}"_s, {{"nameAliases"_L1, QJsonObject{{"A"_L1, "C"_L1}}}});
+        QVERIFY(shop.isValid());
