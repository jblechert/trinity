+    void testSectionElevation()
+    {
+        PathSection sec;
+        QCOMPARE(sec.ascent(), -1);
+        QCOMPARE(sec.descent(), -1);
+        QVERIFY(!sec.hasElevationProfile());
+
+        // computed from the profile
+        sec.setElevationProfile(QPolygonF({{0.0, 100.0}, {10.0, 104.4}, {20.0, 102.0}, {30.0, 103.0}, {40.0, 103.0}}));
+        QVERIFY(sec.hasElevationProfile());
+        QCOMPARE(sec.ascent(), 5);
+        QCOMPARE(sec.descent(), 2);
+
+        // explicitly set values take precedence
+        sec.setAscent(7);
+        sec.setDescent(0);
+        QCOMPARE(sec.ascent(), 7);
+        QCOMPARE(sec.descent(), 0);
+
+        // a single point isn't enough
+        PathSection sec2;
+        sec2.setElevationProfile(QPolygonF({{0.0, 100.0}}));
+        QVERIFY(sec2.hasElevationProfile());
+        QCOMPARE(sec2.ascent(), -1);
+        QCOMPARE(sec2.descent(), -1);
+    }
+
+    void testPathElevation()
+    {
+        Path path;
+        QCOMPARE(path.ascent(), -1);
+        QCOMPARE(path.descent(), -1);
+        QVERIFY(!path.hasElevationProfile());
+        QVERIFY(path.elevationProfile().isEmpty());
+
+        // ~111m along a meridian
+        PathSection sec1;
+        sec1.setPath(QPolygonF({{8.0, 49.0}, {8.0, 49.001}}));
+        sec1.setElevationProfile(QPolygonF({{0.0, 100.0}, {50.0, 110.0}, {120.0, 105.0}}));
+        QCOMPARE(sec1.distance(), 111);
+
+        // no elevation information, e.g. an elevator
+        PathSection sec2;
+        sec2.setPath(QPolygonF({{8.0, 49.001}}));
+        sec2.setManeuver(PathSection::Elevator);
+
+        PathSection sec3;
+        sec3.setPath(QPolygonF({{8.0, 49.001}, {8.0, 49.002}}));
+        sec3.setAscent(20);
+        sec3.setDescent(1);
+
+        PathSection sec4;
+        sec4.setPath(QPolygonF({{8.0, 49.002}, {8.0, 49.003}}));
+        sec4.setElevationProfile(QPolygonF({{0.0, 124.0}, {111.0, 130.0}}));
+
+        path.setSections({sec1, sec2, sec3, sec4});
+        QCOMPARE(path.ascent(), 10 + 20 + 6);
+        QCOMPARE(path.descent(), 5 + 1 + 0);
+        QVERIFY(path.hasElevationProfile());
+
+        const auto profile = path.elevationProfile();
+        QCOMPARE(profile.size(), 5);
+        QCOMPARE(profile[0], QPointF(0.0, 100.0));
+        QCOMPARE(profile[1], QPointF(50.0, 110.0));
+        QCOMPARE(profile[2], QPointF(111.0, 105.0)); // clamped to the section length
+        QCOMPARE(profile[3], QPointF(222.0, 124.0));
+        QCOMPARE(profile[4], QPointF(333.0, 130.0));
+
+        // only profiles: computed from the combined profile, including changes between sections
+        path.setSections({sec1, sec2, sec4});
+        QCOMPARE(path.ascent(), 10 + 19 + 6);
+        QCOMPARE(path.descent(), 5);
+        QCOMPARE(path.elevationProfile().size(), 5);
+    }
