+     */
+    [[nodiscard]] double bearing(QPointF from, QPointF to);
+
+    /** Bearing at the start of poly-line @p path.
+     *  This is measured towards a point some distance along the line, so it is not
+     *  affected by small irregularities of the geometry right at its start.
+     *  @returns nothing if @p path has no meaningful extent.
+     */
+    [[nodiscard]] std::optional<double> startBearing(const QPolygonF &path);
+
+    /** Bearing at the end of poly-line @p path, ie. the direction in which @p path is left.
+     *  @see startBearing
+     */
+    [[nodiscard]] std::optional<double> endBearing(const QPolygonF &path);
+
+    /** Merge very short unnamed sections without turn information into their predecessor.
+     *  Such connectors are common in OSM-based routing results (e.g. crossing a sidewalk)
+     *  and would otherwise result in pointless or wrong turn instructions.
+     *  The turn direction of the section following absorbed connectors is determined here
+     *  from the geometry before absorbing, so that a turn made up of several connectors
+     *  is not lost.
+     */
+    void absorbShortConnectors(std::vector<PathSection> &sections);
+
+    /** Compute missing turn directions from the geometry of adjacent sections.
+     *  Turn directions provided by the backend are not changed.
+     */
+    void fillTurnDirections(std::vector<PathSection> &sections);
+
+    /** Merge consecutive sections that would not result in a distinct navigation instruction,
+     *  e.g. a street that is split into several ways in OSM.
+     *  Requires turn directions to be set, see fillTurnDirections.
+     */
+    void mergeSections(std::vector<PathSection> &sections);
+
+    /** Checks whether the elevation changes along a path consisting of @p sections are computed
+     *  from the combined elevation profile of all sections, rather than summed up per section.
+     *  That is the case if all sections with elevation information only have an elevation profile,
+     *  without explicitly set ascent/descent values.
+     *  @see Path::ascent
+     */
+    [[nodiscard]] bool hasOnlyElevationProfiles(const std::vector<PathSection> &sections);
+
+    /** Merge the elevation information of @p from into @p to, when appending section @p from to section @p to.
+     *  This has to be called before the geometry of @p to is extended, and ensures that the
+     *  ascent, descent and elevation profile of the containing path don't change by merging the sections.
+     *  @param profilesOnly The result of hasOnlyElevationProfiles() for the path containing both sections.
+     */
+    void appendElevation(PathSection &to, const PathSection &from, bool profilesOnly);
+}
+
+}
+
+#endif
