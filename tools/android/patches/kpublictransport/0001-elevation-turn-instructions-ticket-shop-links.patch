+/*
+    SPDX-FileCopyrightText: 2026 Janis Blechert <janis@blechert.at>
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#include "elevationutil_p.h"
+
+#include <QPolygonF>
+
+#include <cmath>
+
+using namespace KPublicTransport;
+
+template <typename Cmp>
+[[nodiscard]] static int sumElevationChanges(const QPolygonF &profile, Cmp cmp)
+{
+    if (profile.size() < 2) {
+        return -1;
+    }
+
+    double sum = 0.0;
+    for (auto it = std::next(profile.begin()); it != profile.end(); ++it) {
+        const auto delta = (*it).y() - (*std::prev(it)).y();
+        if (cmp(delta)) {
+            sum += std::abs(delta);
+        }
+    }
+    return static_cast<int>(std::lround(sum));
+}
+
+int ElevationUtil::ascent(const QPolygonF &profile)
+{
+    return sumElevationChanges(profile, [](double delta) { return delta > 0.0; });
+}
+
+int ElevationUtil::descent(const QPolygonF &profile)
+{
+    return sumElevationChanges(profile, [](double delta) { return delta < 0.0; });
+}
