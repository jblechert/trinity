+        QVERIFY(!makeShop(u"https://example.org/{from.id}"_s,
+                          {{"stationIdentifiers"_L1, QJsonArray{QJsonObject{{"type"_L1, "uic"_L1}, {"aliases"_L1, QJsonObject{{"8000001"_L1, QString()}}}}}}}).isValid());
