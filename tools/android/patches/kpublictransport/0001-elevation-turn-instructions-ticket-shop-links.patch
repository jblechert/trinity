+    void testQmlTypes()
+    {
+        // QPolygonF is opaque to QML, make sure the profile stays accessible as an array of points
+        for (const auto &mo : {PathSection::staticMetaObject, Path::staticMetaObject}) {
+            const auto idx = mo.indexOfProperty("elevationProfile");
+            QVERIFY(idx >= 0);
+            QCOMPARE(mo.property(idx).metaType(), QMetaType::fromType<QList<QPointF>>());
+        }
+
+        PathSection sec;
+        sec.setElevationProfile(QPolygonF({{0.0, 100.0}, {50.0, 110.0}}));
+        const auto v = PathSection::staticMetaObject.property(PathSection::staticMetaObject.indexOfProperty("elevationProfile")).readOnGadget(&sec);
+        QCOMPARE(v.value<QList<QPointF>>(), QList<QPointF>({{0.0, 100.0}, {50.0, 110.0}}));
+    }
