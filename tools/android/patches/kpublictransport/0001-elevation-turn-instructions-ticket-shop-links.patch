 curl "https://europe.motis-project.de/api/v1/plan?fromPlace=52.50602341723939%2C13.45152382711484%2C0&toPlace=52.50494050893889%2C13.448614380176252%2C0&arriveBy=false&timetableView=true&wheelchair=false&mode=WALK" > journey-direct-walk.in.json
 
 curl "https://api.transitous.org/api/v1/map/rentals?max=49.01%2C8.41&min=49.02%2C8.42" > location-rentals.json
+
+# elevation data (Transitous), with the same parameters as Motis2Backend uses
+# MOTIS returns more itineraries than requested, only the first one is kept for the transit case,
+# and the geometry of its public transport leg is removed as that is irrelevant here and only bloats the test data
+curl "https://api.transitous.org/api/v5/plan?fromPlace=49.4118,8.7105,0&toPlace=49.4106,8.7153,0&time=2026-11-18T08:00:00Z&detailedTransfers=true&detailedLegs=true&transitModes=&directModes=WALK,BIKE&preTransitModes=WALK&postTransitModes=WALK&numItineraries=1&arriveBy=false&language=en" > journey-direct-elevation.in.json
+curl "https://api.transitous.org/api/v5/plan?fromPlace=49.4037,8.6756,0&toPlace=49.3800,8.7280,0&time=2026-11-18T08:00:00Z&detailedTransfers=true&detailedLegs=true&transitModes=TRANSIT&directModes=WALK&preTransitModes=WALK&postTransitModes=WALK,BIKE&numItineraries=1&arriveBy=false&language=en" | jq -c '.itineraries |= .[:1] | del(.itineraries[].legs[] | select(.mode != "WALK" and .mode != "BIKE") | .legGeometry)' > journey-transit-elevation.in.json
+# journey-elevation-edge-cases.json is hand-written, covering elevation edge cases not found in recorded data
