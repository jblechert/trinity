+namespace Test {
+    /** Checks that preparing @p path for navigation preserved the elevation information of @p orig.
+     *  Profile distances can differ by up to @p maxDistanceDiff meters due to rounding of per-section distances.
+     */
+    [[nodiscard]] inline bool compareElevation(const KPublicTransport::Path &orig, const KPublicTransport::Path &path, int maxDistanceDiff)
+    {
+        if (orig.ascent() != path.ascent() || orig.descent() != path.descent()) {
+            qWarning() << "ascent/descent changed:" << orig.ascent() << orig.descent() << path.ascent() << path.descent();
+            return false;
+        }
+        // points in the middle of a flat part only carry distance information, which can be lost when
+        // merging a section without geometry (and thus without a length to clamp its profile to)
+        const auto withoutFlatPoints = [](QPolygonF profile) {
+            for (qsizetype i = 1; i + 1 < profile.size();) {
+                if (profile[i - 1].y() == profile[i].y() && profile[i].y() == profile[i + 1].y()) {
+                    profile.remove(i);
+                } else {
+                    ++i;
+                }
+            }
+            return profile;
+        };
+        const auto origProfile = withoutFlatPoints(orig.elevationProfile());
+        const auto profile = withoutFlatPoints(path.elevationProfile());
+        if (origProfile.size() != profile.size()) {
+            qWarning() << "elevation profile size changed:" << origProfile << profile;
+            return false;
+        }
+        for (qsizetype i = 0; i < profile.size(); ++i) {
+            if (origProfile[i].y() != profile[i].y() || std::abs(origProfile[i].x() - profile[i].x()) > maxDistanceDiff) {
+                qWarning() << "elevation profile changed at" << i << origProfile[i] << profile[i];
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Compares the navigation instructions of all non-public transport paths in @p journeys
+     *  against the reference data in @p refFile.
+     *  Requires the KI18n language to be set to en_US.
+     */
+    [[nodiscard]] inline bool compareNavigationInstructions(const QString &refFile, const std::vector<KPublicTransport::Journey> &journeys)
+    {
+        using namespace KPublicTransport;
+        using namespace Qt::Literals::StringLiterals;
+
+        QJsonArray result;
+        for (qsizetype i = 0; i < (qsizetype)journeys.size(); ++i) {
+            const auto &jny = journeys[i];
+            for (qsizetype j = 0; j < (qsizetype)jny.sections().size(); ++j) {
+                const auto &jnySec = jny.sections()[j];
+                if (jnySec.mode() == JourneySection::PublicTransport || jnySec.path().isEmpty()) {
+                    continue;
+                }
+                auto path = jnySec.path();
+                path.prepareForNavigation();
+
+                QJsonArray instructions;
+                for (const auto &pathSec : path.sections()) {
+                    QJsonObject obj{
+                        {"instruction"_L1, pathSec.instruction()},
+                        {"distance"_L1, pathSec.distance()},
+                    };
+                    if (pathSec.turnDirection() != PathSection::UnknownTurnDirection) {
+                        obj.insert("turnDirection"_L1, QLatin1StringView(QMetaEnum::fromType<PathSection::TurnDirection>().valueToKey(pathSec.turnDirection())));
+                    }
+                    instructions.push_back(obj);
+                }
+
+                // allow for rounding differences of per-section distances
+                const auto distanceDiff = std::abs(path.distance() - jnySec.path().distance());
+                if (distanceDiff > (int)(jnySec.path().sections().size() - path.sections().size()) / 2 + 1) {
+                    qWarning() << "path distance changed by" << distanceDiff << "in journey" << i << "section" << j;
+                    return false;
+                }
+                if (!compareElevation(jnySec.path(), path, (int)(jnySec.path().sections().size() - path.sections().size()) + 1)) {
+                    qWarning() << "path elevation changed in journey" << i << "section" << j;
+                    return false;
+                }
+
+                result.push_back(QJsonObject{
+                    {"journey"_L1, i},
+                    {"section"_L1, j},
+                    {"instructions"_L1, instructions},
+                });
+            }
+        }
+
+        if (result.isEmpty()) {
+            qWarning() << "no paths found";
+            return false;
+        }
+        const auto ref = QJsonDocument::fromJson(readFile(refFile)).array();
+        return compareJson(refFile, result, ref);
+    }
+}
+
+#endif
